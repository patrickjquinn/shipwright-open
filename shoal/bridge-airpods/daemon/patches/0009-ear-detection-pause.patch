+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include "AapCapability.h"
+#include "sdk/aap/AapEarDetection.h"
+#include "media/EarPauseController.h"
+
+#include <mutex>
+#include <optional>
+
+namespace MagicPodsCore
+{
+    // "earDetection" (read-only): where each bud is, from packet 0x06.
+    //   {"primary": "inEar", "secondary": "outOfEar",
+    //    "left": "inEar", "right": "outOfEar"}
+    // Each state is "inEar", "outOfEar", "inCase" or "unknown". "left" and
+    // "right" are listed once the battery packet has said which bud is
+    // primary. Listed from the first ear detection packet on.
+    //
+    // It also pauses and resumes the user's media player as buds are taken
+    // out and put back (EarPauseController), following the "earDetectionPause"
+    // setting of the "magicpods" container.
+    class AapEarDetectionCapability : public AapCapability
+    {
+    private:
+        std::mutex _stateMutex{};
+        AapEarDetection _state{};
+        std::optional<AapPrimaryBud> _primaryBud{};
+        EarPauseController _controller;
+
+    protected:
+        nlohmann::json CreateJsonBody() override;
+        void OnReceivedData(const std::vector<unsigned char> &data) override;
+        void Reset() override;
+
+    public:
+        explicit AapEarDetectionCapability(AapDevice &device);
+        void SetFromJson(const nlohmann::json &json) override {}
+    };
+}
