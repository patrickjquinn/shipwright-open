--- /dev/null
+++ b/src/media/EarPauseController.h
@@ -0,0 +1,103 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include "MediaPlayers.h"
+#include "sdk/aap/AapEarDetection.h"
+
+#include <atomic>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace MagicPodsCore
+{
+    // When to pause playback as buds leave the ears. Stored as the string
+    // setting "earDetectionPause" in the "magicpods" settings container.
+    enum class EarPausePolicy
+    {
+        Off,         // "off"
+        OneRemoved,  // "oneRemoved" (default): pause when a worn bud is taken out
+        BothRemoved, // "bothRemoved": pause when no bud is left in an ear
+    };
+
+    std::optional<EarPausePolicy> EarPausePolicyFromString(const std::string &value);
+    std::string EarPausePolicyToString(EarPausePolicy policy);
+
+    // Pauses the playing media player when buds are taken out of the ears,
+    // and resumes it when they are back, for one pair of headphones:
+    //
+    // - Only a change acts. The first state after connecting is recorded;
+    //   so is any change while nothing qualifies.
+    // - Pause: a bud left an ear (into the hand or the case) and the policy
+    //   now holds (one removed: any worn bud out; both removed: none in an
+    //   ear). The player whose PlaybackStatus is "Playing" is paused, and
+    //   remembered as paused by us.
+    // - Resume: only the player we paused, only when as many buds are back in
+    //   the ears as were in them before the pause (both removed: one), and
+    //   only if it is still paused. If the user plays or stops it in the
+    //   meantime it is forgotten, so something the user paused is never
+    //   resumed.
+    // - Losing the link, or the policy becoming Off, forgets it.
+    //
+    // A bud whose state is unknown (not connected) is not counted, so a bud
+    // that runs flat does not pause anything.
+    //
+    // The players' status reports are queued by the listener (which takes
+    // only _reportsMutex) and applied under _mutex when a decision needs
+    // them: after our own Pause, where everything up to the player's answer
+    // is older than the pause and ignored, and before any later decision.
+    // Lock order: _mutex, then the players' locks, then _reportsMutex.
+    class EarPauseController
+    {
+    private:
+        std::mutex _mutex{};
+        std::mutex _reportsMutex{};
+        std::vector<std::pair<std::string, std::string>> _reports{};
+        MediaPlayers &_players;
+        size_t _statusListenerId{};
+        EarPausePolicy _policy{EarPausePolicy::OneRemoved};
+        bool _singleBud{false};
+        std::optional<AapEarDetection> _last{};
+        std::optional<MediaPlayerRef> _paused{};
+        int _resumeAt{};
+
+        static std::atomic<EarPausePolicy> _configuredPolicy;
+
+        int CountInEar(const AapEarDetection &state) const;
+        int CountRemoved(const AapEarDetection &state) const;
+        bool ShouldPause(const AapEarDetection &state) const;
+        void Pause(int inEarBefore);
+        void Resume();
+        void ApplyReports();
+        void HandleReport(const std::string &owner, const std::string &status);
+
+    public:
+        explicit EarPauseController(MediaPlayers &players);
+        ~EarPauseController();
+
+        EarPauseController(const EarPauseController &) = delete;
+        EarPauseController &operator=(const EarPauseController &) = delete;
+
+        void SetPolicy(EarPausePolicy policy);
+        EarPausePolicy GetPolicy();
+        // Headphones with one component (AirPods Max): only the primary
+        // state counts.
+        void SetSingleBud(bool singleBud);
+
+        void OnEarStateChanged(AapEarState primary, AapEarState secondary);
+        // The link to the headphones is gone.
+        void Reset();
+        // The player we paused and would resume, if any, after the reports
+        // received so far.
+        std::optional<MediaPlayerRef> GetPausedPlayer();
+
+        // The policy from the daemon's settings, shared by every device.
+        static void SetConfiguredPolicy(EarPausePolicy policy);
+        static EarPausePolicy GetConfiguredPolicy();
+    };
+}
