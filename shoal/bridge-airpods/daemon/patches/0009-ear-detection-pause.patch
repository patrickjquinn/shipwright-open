+// "earDetectionPause" in the "magicpods" container: when to pause media as
+// buds leave the ears. Unknown values mean the default, "oneRemoved".
+void ApplyEarDetectionPauseSetting(const toml::node_view<toml::node>& value) {
+    EarPausePolicy policy = EarPausePolicy::OneRemoved;
+    if (value.is_string()) {
+        const std::string text = value.as_string()->get();
+        if (auto parsed = EarPausePolicyFromString(text); parsed.has_value())
+            policy = parsed.value();
+        else
+            Logger::Warn("Unknown earDetectionPause \"%s\"; using oneRemoved", text.c_str());
+    }
+    else if (value) {
+        Logger::Warn("earDetectionPause is not a string; using oneRemoved");
+    }
+    EarPauseController::SetConfiguredPolicy(policy);
+    Logger::Info("Ear detection pause: %s", EarPausePolicyToString(policy).c_str());
+}
+
+void StartListeningEarDetectionPauseSettings(SettingsService &settingsService) {
+    ApplyEarDetectionPauseSetting(settingsService.GetSetting("magicpods", "earDetectionPause"));
+
+    settingsService.GetOnSettingUpdateEvent().Subscribe([](size_t listenerId, const UpdatedSettingNotification& notification) {
+        if (notification.GetContainerName() == "magicpods" && notification.GetSettingName() == "earDetectionPause")
+            ApplyEarDetectionPauseSetting(notification.GetValue());
+    });
+}
+
 int main(int argc, char** argv) {
     if (TryToParseArguments(argc, argv))
         return 0;
 
     std::shared_ptr<SettingsService> settingsService = std::make_shared<SettingsService>(SettingsService::GetConfigPath("config.toml"));
     StartListeningLogSettings(*settingsService);
+    StartListeningEarDetectionPauseSettings(*settingsService);
 
     // fix stdout buffering issue, when python does not receive output
     setvbuf(stdout, NULL, _IONBF, 0);
@@ -588,6 +619,9 @@ int main(int argc, char** argv) {
             TestsPbp pbp;
