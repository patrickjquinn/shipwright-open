--- /dev/null
+++ b/src/tests/TestsEarPauseMpris.cpp
@@ -0,0 +1,140 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "TestsEarPauseMpris.h"
+#include "media/EarPauseController.h"
+#include "media/MprisClient.h"
+#include "Logger.h"
+
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <thread>
+#include <sdbus-c++/sdbus-c++.h>
+
+using namespace MagicPodsCore;
+
+namespace
+{
+    constexpr auto Music = "org.mpris.MediaPlayer2.music";
+    constexpr auto App = "org.mpris.MediaPlayer2.app";
+    constexpr auto In = AapEarState::InEar;
+    constexpr auto Out = AapEarState::OutOfEar;
+
+    std::unique_ptr<sdbus::IProxy> UserProxy(const std::string &name)
+    {
+        return sdbus::createProxy(sdbus::createSessionBusConnection(), name, MprisClient::PlayerPath,
+                                  sdbus::dont_run_event_loop_thread);
+    }
+
+    // What another client (the lock screen, the player's own UI) sees and does.
+    std::string StatusOf(const std::string &name)
+    {
+        try {
+            sdbus::Variant value{};
+            UserProxy(name)
+                ->callMethod("Get")
+                .onInterface("org.freedesktop.DBus.Properties")
+                .withArguments(std::string{MprisClient::PlayerInterface}, std::string{"PlaybackStatus"})
+                .storeResultsTo(value);
+            return value.get<std::string>();
+        }
+        catch (const std::exception &error) {
+            Logger::Error("Reading %s failed: %s", name.c_str(), error.what());
+            return {};
+        }
+    }
+
+    bool UserCall(const std::string &name, const char *method)
+    {
+        try {
+            UserProxy(name)->callMethod(method).onInterface(MprisClient::PlayerInterface).storeResultsTo();
+            return true;
+        }
+        catch (const std::exception &error) {
+            Logger::Error("%s on %s failed: %s", method, name.c_str(), error.what());
+            return false;
+        }
+    }
+
+    // The player's report of a change reaches our socket a moment after the
+    // user's call returns; GetPausedPlayer() delivers what has arrived.
+    bool WaitFor(const std::function<bool()> &condition)
+    {
+        for (int i = 0; i < 50; ++i) {
+            if (condition())
+                return true;
+            std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        }
+        return condition();
+    }
+}
+
+bool TestsEarPauseMpris::TestMprisFindsPlayingPlayer()
+{
+    auto player = MprisClient::Instance().FindPlaying();
+    return player.has_value() && player->name == Music && !player->owner.empty() && player->owner[0] == ':' &&
+           MprisClient::Instance().GetPlaybackStatus(player.value()) == "Playing";
+}
+
+bool TestsEarPauseMpris::TestMprisPauseAndResume()
+{
+    EarPauseController controller{MprisClient::Instance()};
+    controller.OnEarStateChanged(In, In);
+    controller.OnEarStateChanged(Out, In);
+    const bool paused = StatusOf(Music) == "Paused" && controller.GetPausedPlayer().has_value() &&
+                        controller.GetPausedPlayer()->name == Music;
+    // Our own pause comes back as a signal; it must not cancel the resume.
+    std::this_thread::sleep_for(std::chrono::milliseconds(300));
+    const bool kept = controller.GetPausedPlayer().has_value();
+    controller.OnEarStateChanged(In, In);
+    return paused && kept && StatusOf(Music) == "Playing" && StatusOf(App) == "Paused";
+}
+
+bool TestsEarPauseMpris::TestMprisUserTakeOverNotResumed()
+{
+    EarPauseController controller{MprisClient::Instance()};
+    controller.OnEarStateChanged(In, In);
+    controller.OnEarStateChanged(Out, In);
+    const bool paused = StatusOf(Music) == "Paused" && controller.GetPausedPlayer().has_value();
+    // The user plays it again with one bud out, then pauses it.
+    UserCall(Music, "Play");
+    const bool forgotten = WaitFor([&controller]() { return !controller.GetPausedPlayer().has_value(); });
+    UserCall(Music, "Pause");
+    controller.OnEarStateChanged(In, In);
+    const bool stayedPaused = StatusOf(Music) == "Paused";
+    UserCall(Music, "Play"); // back to the starting state
+    return paused && forgotten && stayedPaused && StatusOf(Music) == "Playing";
+}
+
+bool TestsEarPauseMpris::TestMprisUserPausedNotResumed()
+{
+    UserCall(Music, "Pause");
+    EarPauseController controller{MprisClient::Instance()};
+    controller.OnEarStateChanged(In, In);
+    controller.OnEarStateChanged(Out, In);
+    const bool nothingPaused = !controller.GetPausedPlayer().has_value();
+    controller.OnEarStateChanged(In, In);
+    std::this_thread::sleep_for(std::chrono::milliseconds(300));
+    return nothingPaused && StatusOf(Music) == "Paused" && StatusOf(App) == "Paused";
+}
+
+void TestsEarPauseMpris::Test(const char *name, bool b)
+{
+    int spaceCount = 50 - static_cast<int>(std::strlen(name));
+    std::string space(spaceCount > 0 ? spaceCount : 1, ' ');
+    Logger::Debug("%s%s: %s", name, space.c_str(), b ? "PASS" : "FAIL");
+}
+
+TestsEarPauseMpris::TestsEarPauseMpris()
+{
+    if (std::getenv("MAGICPODS_TEST_MPRIS") == nullptr)
+        return;
+    Test("TestMprisFindsPlayingPlayer", TestMprisFindsPlayingPlayer());
+    Test("TestMprisPauseAndResume", TestMprisPauseAndResume());
+    Test("TestMprisUserTakeOverNotResumed", TestMprisUserTakeOverNotResumed());
+    Test("TestMprisUserPausedNotResumed", TestMprisUserPausedNotResumed());
+}
