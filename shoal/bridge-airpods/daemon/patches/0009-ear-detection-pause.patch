new file mode 100644
index 0000000..06c3f01
--- /dev/null
+++ b/src/media/MediaPlayers.h
@@ -0,0 +1,53 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include <cstddef>
+#include <functional>
+#include <optional>
+#include <string>
+
+namespace MagicPodsCore
+{
+    // A media player found on the bus: its well-known name
+    // ("org.mpris.MediaPlayer2.foo") and the unique name that owned it when
+    // it was found (":1.42"). Calls go to the owner, so a player that quit
+    // and started again is a different player.
+    struct MediaPlayerRef
+    {
+        std::string name{};
+        std::string owner{};
+
+        bool operator==(const MediaPlayerRef &other) const = default;
+    };
+
+    // The media players of the user session. MprisClient is the real one;
+    // the tests use a fake.
+    class MediaPlayers
+    {
+    public:
+        using StatusListener = std::function<void(const std::string &owner, const std::string &status)>;
+
+        virtual ~MediaPlayers() = default;
+
+        // The first player, by name, whose PlaybackStatus is "Playing".
+        virtual std::optional<MediaPlayerRef> FindPlaying() = 0;
+        // "Playing", "Paused" or "Stopped"; empty if the player is gone or
+        // does not answer.
+        virtual std::string GetPlaybackStatus(const MediaPlayerRef &player) = 0;
+        virtual bool Pause(const MediaPlayerRef &player) = 0;
+        virtual bool Play(const MediaPlayerRef &player) = 0;
+
+        // Delivers the PlaybackStatus reports (owner, status) received since
+        // the last delivery to every listener, in the order the players sent
+        // them, on the caller's thread. Pause() and Play() also deliver what
+        // arrived up to their reply, so a report delivered after one of them
+        // returns was sent after the player handled it. Listeners must not
+        // call back into this object.
+        virtual void ProcessStatusReports() = 0;
+        virtual size_t SubscribeStatusChanged(StatusListener listener) = 0;
+        virtual void UnsubscribeStatusChanged(size_t id) = 0;
+    };
+}
diff --git a/src/media/MprisClient.cpp b/src/media/MprisClient.cpp
new file mode 100644
index 0000000..95afce0
--- /dev/null
+++ b/src/media/MprisClient.cpp
@@ -0,0 +1,220 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "MprisClient.h"
+#include "Logger.h"
+
+#include <algorithm>
+#include <chrono>
+
+namespace MagicPodsCore
+{
+    namespace
+    {
+        constexpr auto BUS_NAME = "org.freedesktop.DBus";
+        constexpr auto BUS_PATH = "/org/freedesktop/DBus";
+        constexpr auto PROPERTIES_INTERFACE = "org.freedesktop.DBus.Properties";
+        // A player that does not answer within this time is skipped.
+        constexpr auto CALL_TIMEOUT = std::chrono::milliseconds(1000);
+        // Signals handled per delivery at most; the rest wait for the next.
+        constexpr int MAX_SIGNALS_PER_DRAIN = 1000;
+    }
+
+    MprisClient &MprisClient::Instance()
+    {
+        static MprisClient instance{};
+        return instance;
+    }
+
+    bool MprisClient::Connect()
+    {
+        if (_connection)
+            return true;
+        try {
+            _connection = sdbus::createSessionBusConnection();
+            _connection->addMatch(
+                std::string{"type='signal',interface='"} + PROPERTIES_INTERFACE +
+                    "',member='PropertiesChanged',path='" + PlayerPath + "',arg0='" + PlayerInterface + "'",
+                [this](sdbus::Message &message) { OnPropertiesChanged(message); },
+                sdbus::floating_slot);
+            Logger::Info("Connected to the session bus for media players");
+            return true;
+        }
+        catch (const sdbus::Error &error) {
+            Logger::Warn("Cannot reach media players on the session bus: %s", error.what());
+            Disconnect();
+            return false;
+        }
+    }
+
+    void MprisClient::Disconnect()
+    {
+        _connection.reset();
+    }
+
+    // Handles the queued signals on this thread (OnPropertiesChanged).
+    void MprisClient::Drain()
+    {
+        try {
+            for (int i = 0; i < MAX_SIGNALS_PER_DRAIN && _connection->processPendingRequest(); ++i) {
+            }
+        }
+        catch (const sdbus::Error &error) {
+            Logger::Warn("Lost the session bus connection for media players: %s", error.what());
+            Disconnect();
+        }
+    }
+
+    void MprisClient::OnPropertiesChanged(sdbus::Message &message)
+    {
+        std::string status{};
+        try {
+            std::string interfaceName{};
+            std::map<std::string, sdbus::Variant> changed{};
+            message >> interfaceName >> changed;
+            const auto it = changed.find("PlaybackStatus");
+            if (interfaceName != PlayerInterface || it == changed.end())
+                return;
+            status = it->second.get<std::string>();
+        }
+        catch (const std::exception &error) {
+            Logger::Debug("Ignoring a malformed PropertiesChanged from a media player: %s", error.what());
+            return;
+        }
+
+        const std::string owner = message.getSender();
+        std::lock_guard lock{_listenersMutex};
+        for (auto &[id, listener] : _listeners)
+            listener(owner, status);
+    }
+
+    std::vector<std::string> MprisClient::ListPlayerNames()
+    {
+        std::vector<std::string> names{};
+        auto proxy = sdbus::createProxy(*_connection, BUS_NAME, BUS_PATH);
+        proxy->callMethod("ListNames").onInterface(BUS_NAME).withTimeout(CALL_TIMEOUT).storeResultsTo(names);
+        const std::string prefix{PlayerPrefix};
+        names.erase(std::remove_if(names.begin(), names.end(),
+                                   [&prefix](const std::string &name) { return name.rfind(prefix, 0) != 0; }),
+                    names.end());
+        std::sort(names.begin(), names.end());
+        return names;
+    }
+
+    std::string MprisClient::GetNameOwner(const std::string &name)
+    {
+        std::string owner{};
+        auto proxy = sdbus::createProxy(*_connection, BUS_NAME, BUS_PATH);
+        proxy->callMethod("GetNameOwner").onInterface(BUS_NAME).withArguments(name).withTimeout(CALL_TIMEOUT).storeResultsTo(owner);
+        return owner;
+    }
+
+    std::string MprisClient::ReadPlaybackStatus(const std::string &destination)
+    {
+        sdbus::Variant value{};
+        auto proxy = sdbus::createProxy(*_connection, destination, PlayerPath);
+        proxy->callMethod("Get")
+            .onInterface(PROPERTIES_INTERFACE)
+            .withArguments(std::string{PlayerInterface}, std::string{"PlaybackStatus"})
+            .withTimeout(CALL_TIMEOUT)
+            .storeResultsTo(value);
+        return value.get<std::string>();
+    }
+
+    std::optional<MediaPlayerRef> MprisClient::FindPlaying()
+    {
+        std::lock_guard lock{_mutex};
+        if (!Connect())
+            return std::nullopt;
+
+        std::vector<std::string> names{};
+        try {
+            names = ListPlayerNames();
+        }
+        catch (const sdbus::Error &error) {
+            // The bus itself failed: connect again next time.
+            Logger::Warn("Cannot list media players: %s", error.what());
+            Disconnect();
+            return std::nullopt;
+        }
+
+        for (const auto &name : names) {
+            try {
+                MediaPlayerRef player{name, GetNameOwner(name)};
+                const std::string status = ReadPlaybackStatus(player.owner);
+                Logger::Debug("Media player %s (%s) is %s", name.c_str(), player.owner.c_str(), status.c_str());
+                if (status == "Playing")
+                    return player;
+            }
+            catch (const std::exception &error) {
+                Logger::Debug("Media player %s did not answer: %s", name.c_str(), error.what());
+            }
+        }
+        return std::nullopt;
+    }
+
+    std::string MprisClient::GetPlaybackStatus(const MediaPlayerRef &player)
+    {
+        std::lock_guard lock{_mutex};
+        if (!Connect())
+            return {};
+        try {
+            return ReadPlaybackStatus(player.owner);
+        }
+        catch (const std::exception &error) {
+            Logger::Debug("Media player %s did not answer: %s", player.name.c_str(), error.what());
+            return {};
+        }
+    }
+
+    bool MprisClient::Call(const MediaPlayerRef &player, const char *method)
+    {
+        std::lock_guard lock{_mutex};
+        if (!Connect())
+            return false;
+        bool done = false;
+        try {
+            auto proxy = sdbus::createProxy(*_connection, player.owner, PlayerPath);
+            proxy->callMethod(method).onInterface(PlayerInterface).withTimeout(CALL_TIMEOUT).storeResultsTo();
+            done = true;
+        }
+        catch (const sdbus::Error &error) {
+            Logger::Warn("%s on %s failed: %s", method, player.name.c_str(), error.what());
+        }
+        // What the player reported before its answer belongs before this call.
+        if (_connection)
+            Drain();
+        return done;
+    }
+
+    bool MprisClient::Pause(const MediaPlayerRef &player)
+    {
+        return Call(player, "Pause");
+    }
+
+    bool MprisClient::Play(const MediaPlayerRef &player)
+    {
+        return Call(player, "Play");
+    }
+
+    void MprisClient::ProcessStatusReports()
+    {
+        std::lock_guard lock{_mutex};
+        if (_connection)
+            Drain();
+    }
+
+    size_t MprisClient::SubscribeStatusChanged(StatusListener listener)
+    {
+        std::lock_guard lock{_listenersMutex};
+        _listeners.emplace(++_nextListenerId, std::move(listener));
+        return _nextListenerId;
+    }
+
+    void MprisClient::UnsubscribeStatusChanged(size_t id)
+    {
+        std::lock_guard lock{_listenersMutex};
+        _listeners.erase(id);
+    }
+}
diff --git a/src/media/MprisClient.h b/src/media/MprisClient.h
new file mode 100644
index 0000000..5c85e4f
--- /dev/null
+++ b/src/media/MprisClient.h
@@ -0,0 +1,65 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include "MediaPlayers.h"
+
+#include <map>
+#include <memory>
+#include <mutex>
+#include <vector>
+#include <sdbus-c++/sdbus-c++.h>
+
+namespace MagicPodsCore
+{
+    // The user's media players over MPRIS (org.mpris.MediaPlayer2.*) on the
+    // session bus.
+    //
+    // It connects on first use, not at start-up, and tries again on the next
+    // use if the session bus is not there. One connection and no event loop
+    // thread: calls are made with a timeout on the caller's thread, and the
+    // players' PropertiesChanged signals wait in the connection's queue until
+    // ProcessStatusReports() (or a Pause or Play) delivers them, in order. So
+    // a report always reaches the listeners in its true order relative to
+    // our own calls: one sent before a player answered our Pause is
+    // delivered before Pause returns.
+    class MprisClient : public MediaPlayers
+    {
+    private:
+        std::mutex _mutex{};
+        std::unique_ptr<sdbus::IConnection> _connection{};
+
+        std::mutex _listenersMutex{};
+        std::map<size_t, StatusListener> _listeners{};
+        size_t _nextListenerId{};
+
+        bool Connect();
+        void Disconnect();
+        void Drain();
+        void OnPropertiesChanged(sdbus::Message &message);
+        std::vector<std::string> ListPlayerNames();
+        std::string GetNameOwner(const std::string &name);
+        std::string ReadPlaybackStatus(const std::string &destination);
+        bool Call(const MediaPlayerRef &player, const char *method);
+
+        MprisClient() = default;
+
+    public:
+        static constexpr const char *PlayerPrefix = "org.mpris.MediaPlayer2.";
+        static constexpr const char *PlayerPath = "/org/mpris/MediaPlayer2";
+        static constexpr const char *PlayerInterface = "org.mpris.MediaPlayer2.Player";
+
+        static MprisClient &Instance();
+        ~MprisClient() override = default;
+
+        std::optional<MediaPlayerRef> FindPlaying() override;
+        std::string GetPlaybackStatus(const MediaPlayerRef &player) override;
+        bool Pause(const MediaPlayerRef &player) override;
+        bool Play(const MediaPlayerRef &player) override;
+        void ProcessStatusReports() override;
+        size_t SubscribeStatusChanged(StatusListener listener) override;
+        void UnsubscribeStatusChanged(size_t id) override;
+    };
+}
diff --git a/src/sdk/aap/AapEarDetection.cpp b/src/sdk/aap/AapEarDetection.cpp
