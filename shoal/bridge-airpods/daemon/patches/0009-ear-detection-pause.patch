@@ -0,0 +1,74 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "AapEarDetection.h"
+#include "sdk/aap/enums/AapCmd.h"
+#include "sdk/aap/enums/AapBatteryType.h"
+
+namespace MagicPodsCore
+{
+    AapEarState AapEarStateFromByte(unsigned char value)
+    {
+        switch (value) {
+        case 0x00:
+            return AapEarState::InEar;
+        case 0x01:
+            return AapEarState::OutOfEar;
+        case 0x02:
+            return AapEarState::InCase;
+        default:
+            return AapEarState::Unknown;
+        }
+    }
+
+    std::string AapEarStateToString(AapEarState state)
+    {
+        switch (state) {
+        case AapEarState::InEar:
+            return "inEar";
+        case AapEarState::OutOfEar:
+            return "outOfEar";
+        case AapEarState::InCase:
+            return "inCase";
+        default:
+            return "unknown";
+        }
+    }
+
+    std::optional<AapEarDetection> AapEarDetection::Parse(const std::vector<unsigned char> &data)
+    {
+        if (data.size() < 8)
+            return std::nullopt;
+        if (data[0] != 0x04 || data[1] != 0x00 || data[2] != 0x04 || data[3] != 0x00 ||
+            data[4] != static_cast<unsigned char>(AapCmd::EarDetection) || data[5] != 0x00)
+            return std::nullopt;
+
+        AapEarDetection result{};
+        result.primary = AapEarStateFromByte(data[6]);
+        result.secondary = AapEarStateFromByte(data[7]);
+        return result;
+    }
+
+    std::optional<AapPrimaryBud> AapParsePrimaryBud(const std::vector<unsigned char> &data)
+    {
+        if (data.size() < 7 || data[4] != static_cast<unsigned char>(AapCmd::Battery))
+            return std::nullopt;
+
+        const size_t count = data[6];
+        size_t offset = 7;
+        for (size_t i = 0; i < count && offset + 5 <= data.size(); ++i, offset += 5) {
+            switch (static_cast<AapBatteryType>(data[offset])) {
+            case AapBatteryType::Left:
+                return AapPrimaryBud::Left;
+            case AapBatteryType::Right:
+                return AapPrimaryBud::Right;
+            case AapBatteryType::Single:
+                return AapPrimaryBud::Single;
+            default:
+                break; // the case: look further
+            }
+        }
+        return std::nullopt;
+    }
+}
diff --git a/src/sdk/aap/AapEarDetection.h b/src/sdk/aap/AapEarDetection.h
new file mode 100644
index 0000000..c6fe9f0
--- /dev/null
+++ b/src/sdk/aap/AapEarDetection.h
@@ -0,0 +1,55 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace MagicPodsCore
+{
+    // Where a bud is, as the ear detection packet reports it.
+    enum class AapEarState : unsigned char
+    {
+        InEar = 0x00,
+        OutOfEar = 0x01,
+        InCase = 0x02,
+        // Any other byte: the bud is not connected, or the value is new.
+        Unknown = 0xFF,
+    };
+
+    AapEarState AapEarStateFromByte(unsigned char value);
+    std::string AapEarStateToString(AapEarState state); // "inEar", "outOfEar", "inCase", "unknown"
+
+    // Packet type 0x06, sent by the AirPods whenever a bud is put in or taken
+    // out of an ear, or put in the case:
+    //   04 00 04 00 06 00 <primary> <secondary>
+    // The primary bud is the one holding the link to the host. When it is
+    // taken out, the AirPods usually make the other bud primary and send the
+    // packet again.
+    struct AapEarDetection
+    {
+        AapEarState primary{AapEarState::Unknown};
+        AapEarState secondary{AapEarState::Unknown};
+
+        static std::optional<AapEarDetection> Parse(const std::vector<unsigned char> &data);
+    };
+
+    // Which bud is primary, from the battery packet (type 0x04), which lists
+    // the primary bud before the secondary one:
+    //   04 00 04 00 04 00 <count> then per component
+    //   <type> 01 <level> <status> 01, type 0x01 single, 0x02 right,
+    //   0x04 left, 0x08 case.
+    enum class AapPrimaryBud : unsigned char
+    {
+        Left,
+        Right,
+        // Headphones with one component (AirPods Max, Beats over-ear): only
+        // the primary state means something.
+        Single,
+    };
+
+    std::optional<AapPrimaryBud> AapParsePrimaryBud(const std::vector<unsigned char> &data);
+}
