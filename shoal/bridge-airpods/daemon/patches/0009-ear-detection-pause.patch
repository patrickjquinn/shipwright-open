diff --git a/src/media/EarPauseController.cpp b/src/media/EarPauseController.cpp
new file mode 100644
index 0000000..323b3a9
--- /dev/null
+++ b/src/media/EarPauseController.cpp
@@ -0,0 +1,211 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "EarPauseController.h"
+#include "Logger.h"
+
+namespace MagicPodsCore
+{
+    std::atomic<EarPausePolicy> EarPauseController::_configuredPolicy{EarPausePolicy::OneRemoved};
+
+    std::optional<EarPausePolicy> EarPausePolicyFromString(const std::string &value)
+    {
+        if (value == "off")
+            return EarPausePolicy::Off;
+        if (value == "oneRemoved")
+            return EarPausePolicy::OneRemoved;
+        if (value == "bothRemoved")
+            return EarPausePolicy::BothRemoved;
+        return std::nullopt;
+    }
+
+    std::string EarPausePolicyToString(EarPausePolicy policy)
+    {
+        switch (policy) {
+        case EarPausePolicy::Off:
+            return "off";
+        case EarPausePolicy::BothRemoved:
+            return "bothRemoved";
+        default:
+            return "oneRemoved";
+        }
+    }
+
+    EarPauseController::EarPauseController(MediaPlayers &players) : _players(players)
+    {
+        _statusListenerId = _players.SubscribeStatusChanged([this](const std::string &owner, const std::string &status) {
+            std::lock_guard lock{_reportsMutex};
+            _reports.emplace_back(owner, status);
+        });
+    }
+
+    EarPauseController::~EarPauseController()
+    {
+        // Waits for a listener call in progress, so none runs after this.
+        _players.UnsubscribeStatusChanged(_statusListenerId);
+    }
+
+    void EarPauseController::SetPolicy(EarPausePolicy policy)
+    {
+        std::lock_guard lock{_mutex};
+        if (policy == _policy)
+            return;
+        _policy = policy;
+        if (policy == EarPausePolicy::Off && _paused.has_value()) {
+            Logger::Info("Ear detection pause turned off; will not resume %s", _paused->name.c_str());
+            _paused.reset();
+        }
+    }
+
+    EarPausePolicy EarPauseController::GetPolicy()
+    {
+        std::lock_guard lock{_mutex};
+        return _policy;
+    }
+
+    void EarPauseController::SetSingleBud(bool singleBud)
+    {
+        std::lock_guard lock{_mutex};
+        _singleBud = singleBud;
+    }
+
+    int EarPauseController::CountInEar(const AapEarDetection &state) const
+    {
+        int count = state.primary == AapEarState::InEar ? 1 : 0;
+        if (!_singleBud && state.secondary == AapEarState::InEar)
+            ++count;
+        return count;
+    }
+
+    int EarPauseController::CountRemoved(const AapEarDetection &state) const
+    {
+        auto removed = [](AapEarState s) { return s == AapEarState::OutOfEar || s == AapEarState::InCase; };
+        int count = removed(state.primary) ? 1 : 0;
+        if (!_singleBud && removed(state.secondary))
+            ++count;
+        return count;
+    }
+
+    bool EarPauseController::ShouldPause(const AapEarDetection &state) const
+    {
+        switch (_policy) {
+        case EarPausePolicy::OneRemoved:
+            return CountRemoved(state) >= 1;
+        case EarPausePolicy::BothRemoved:
+            return CountInEar(state) == 0 && CountRemoved(state) >= 1;
+        default:
+            return false;
+        }
+    }
+
+    void EarPauseController::OnEarStateChanged(AapEarState primary, AapEarState secondary)
+    {
+        std::lock_guard lock{_mutex};
+        // The user may have taken over the player we paused meanwhile. Also
+        // keeps the players' reports from piling up between pauses.
+        ApplyReports();
+
+        const AapEarDetection state{primary, secondary};
+        const std::optional<AapEarDetection> last = _last;
+        _last = state;
+        if (!last.has_value() || _policy == EarPausePolicy::Off)
+            return;
+
+        const int before = CountInEar(last.value());
+        const int now = CountInEar(state);
+        if (now < before && !_paused.has_value() && ShouldPause(state))
+            Pause(before);
+        else if (now > before && _paused.has_value() && now >= _resumeAt)
+            Resume();
+    }
+
+    void EarPauseController::Pause(int inEarBefore)
+    {
+        const auto player = _players.FindPlaying();
+        if (!player.has_value()) {
+            Logger::Debug("Bud removed; no media player is playing");
+            return;
+        }
+        const bool paused = _players.Pause(player.value());
+        // Reports up to the player's answer predate the pause: none of them
+        // means the user took over.
+        ApplyReports();
+        if (!paused) {
+            Logger::Warn("Bud removed; failed to pause %s", player->name.c_str());
+            return;
+        }
+        Logger::Info("Bud removed; paused %s", player->name.c_str());
+        _paused = player;
+        _resumeAt = _policy == EarPausePolicy::BothRemoved ? 1 : inEarBefore;
+    }
+
+    void EarPauseController::Resume()
+    {
+        ApplyReports();
+        if (!_paused.has_value())
+            return;
+        const MediaPlayerRef player = _paused.value();
+        _paused.reset();
+        const std::string status = _players.GetPlaybackStatus(player);
+        if (status != "Paused") {
+            Logger::Info("Buds back in; not resuming %s, which is %s", player.name.c_str(),
+                         status.empty() ? "gone" : status.c_str());
+            return;
+        }
+        if (_players.Play(player))
+            Logger::Info("Buds back in; resumed %s", player.name.c_str());
+        else
+            Logger::Warn("Buds back in; failed to resume %s", player.name.c_str());
+    }
+
+    void EarPauseController::Reset()
+    {
+        std::lock_guard lock{_mutex};
+        ApplyReports();
+        _last.reset();
+        if (_paused.has_value()) {
+            Logger::Info("Headphones disconnected; will not resume %s", _paused->name.c_str());
+            _paused.reset();
+        }
+    }
+
+    void EarPauseController::ApplyReports()
+    {
+        _players.ProcessStatusReports();
+        std::vector<std::pair<std::string, std::string>> reports{};
+        {
+            std::lock_guard lock{_reportsMutex};
+            reports.swap(_reports);
+        }
+        for (const auto &[owner, status] : reports)
+            HandleReport(owner, status);
+    }
+
+    void EarPauseController::HandleReport(const std::string &owner, const std::string &status)
+    {
+        // Our own Pause reports "Paused". Anything else after it means the
+        // user (or the player) took over: from now on it is theirs.
+        if (_paused.has_value() && _paused->owner == owner && status != "Paused") {
+            Logger::Info("%s is %s; will not resume it", _paused->name.c_str(), status.c_str());
+            _paused.reset();
+        }
+    }
+
+    std::optional<MediaPlayerRef> EarPauseController::GetPausedPlayer()
+    {
+        std::lock_guard lock{_mutex};
+        ApplyReports();
+        return _paused;
+    }
+
+    void EarPauseController::SetConfiguredPolicy(EarPausePolicy policy)
+    {
+        _configuredPolicy = policy;
+    }
+
+    EarPausePolicy EarPauseController::GetConfiguredPolicy()
+    {
+        return _configuredPolicy;
+    }
+}
