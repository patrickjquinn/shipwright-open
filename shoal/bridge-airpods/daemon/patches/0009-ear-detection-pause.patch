@@ -0,0 +1,79 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "AapEarDetectionCapability.h"
+#include "media/MprisClient.h"
+
+namespace MagicPodsCore
+{
+    AapEarDetectionCapability::AapEarDetectionCapability(AapDevice &device)
+        : AapCapability("earDetection", true, device), _controller(MprisClient::Instance())
+    {
+    }
+
+    nlohmann::json AapEarDetectionCapability::CreateJsonBody()
+    {
+        std::lock_guard lock{_stateMutex};
+        auto body = nlohmann::json::object();
+        body["primary"] = AapEarStateToString(_state.primary);
+        body["secondary"] = AapEarStateToString(_state.secondary);
+        if (_primaryBud == AapPrimaryBud::Left || _primaryBud == AapPrimaryBud::Right) {
+            const bool leftPrimary = _primaryBud == AapPrimaryBud::Left;
+            body["left"] = AapEarStateToString(leftPrimary ? _state.primary : _state.secondary);
+            body["right"] = AapEarStateToString(leftPrimary ? _state.secondary : _state.primary);
+        }
+        return body;
+    }
+
+    void AapEarDetectionCapability::OnReceivedData(const std::vector<unsigned char> &data)
+    {
+        if (auto primaryBud = AapParsePrimaryBud(data); primaryBud.has_value()) {
+            bool changed = false;
+            {
+                std::lock_guard lock{_stateMutex};
+                changed = _primaryBud != primaryBud;
+                _primaryBud = primaryBud;
+            }
+            if (changed) {
+                _controller.SetSingleBud(primaryBud == AapPrimaryBud::Single);
+                if (isAvailable)
+                    _onChanged.FireEvent(*this);
+            }
+            return;
+        }
+
+        auto earDetection = AapEarDetection::Parse(data);
+        if (!earDetection.has_value())
+            return;
+
+        bool changed = false;
+        {
+            std::lock_guard lock{_stateMutex};
+            changed = !isAvailable || _state.primary != earDetection->primary || _state.secondary != earDetection->secondary;
+            _state = earDetection.value();
+            isAvailable = true;
+        }
+        if (changed) {
+            Logger::Info("Ear detection: primary %s, secondary %s", AapEarStateToString(earDetection->primary).c_str(),
+                         AapEarStateToString(earDetection->secondary).c_str());
+            _onChanged.FireEvent(*this);
+        }
+
+        // The policy is read on every packet, so a changed setting applies
+        // from the next change of the buds on.
+        _controller.SetPolicy(EarPauseController::GetConfiguredPolicy());
+        _controller.OnEarStateChanged(earDetection->primary, earDetection->secondary);
+    }
+
+    void AapEarDetectionCapability::Reset()
+    {
+        {
+            std::lock_guard lock{_stateMutex};
+            AapCapability::Reset();
+            _state = AapEarDetection{};
+            _primaryBud.reset();
+        }
+        _controller.Reset();
+    }
+}
diff --git a/src/device/capabilities/aap/AapEarDetectionCapability.h b/src/device/capabilities/aap/AapEarDetectionCapability.h
