+++ b/src/tests/TestsAapEarDetection.cpp
@@ -0,0 +1,464 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "TestsAapEarDetection.h"
+#include "sdk/aap/AapEarDetection.h"
+#include "media/EarPauseController.h"
+#include "Logger.h"
+
+#include <cstring>
+#include <functional>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+using namespace MagicPodsCore;
+
+namespace
+{
+    constexpr auto In = AapEarState::InEar;
+    constexpr auto Out = AapEarState::OutOfEar;
+    constexpr auto Case = AapEarState::InCase;
+    constexpr auto Gone = AapEarState::Unknown;
+
+    // Media players in memory, with MprisClient's delivery contract: status
+    // reports wait in a queue until ProcessStatusReports(), and Pause() and
+    // Play() deliver everything up to and including the player's own report
+    // of the change before they return.
+    class FakeMediaPlayers : public MediaPlayers
+    {
+    public:
+        struct Player
+        {
+            std::string owner;
+            std::string status;
+            int pauses = 0;
+            int plays = 0;
+        };
+        std::map<std::string, Player> players{};
+        std::map<size_t, StatusListener> listeners{};
+        std::vector<std::pair<std::string, std::string>> queued{};
+        size_t nextId{};
+        // Runs when Pause is called, before the player answers: for reports
+        // that reach us only while we wait for that answer.
+        std::function<void()> beforePauseAnswer{};
+
+        void Add(const std::string &name, const std::string &owner, const std::string &status)
+        {
+            players[name] = Player{owner, status};
+        }
+
+        Player &Get(const std::string &name) { return players.at(name); }
+
+        // The player changes its status and reports it, as after the user
+        // pressed a key. Delivered later.
+        void Report(const std::string &name, const std::string &status)
+        {
+            auto &player = players.at(name);
+            player.status = status;
+            queued.emplace_back(player.owner, status);
+        }
+
+        void ProcessStatusReports() override
+        {
+            auto reports = std::move(queued);
+            queued.clear();
+            for (const auto &[owner, status] : reports)
+                for (auto &[id, listener] : listeners)
+                    listener(owner, status);
+        }
+
+        std::optional<MediaPlayerRef> FindPlaying() override
+        {
+            for (auto &[name, player] : players)
+                if (player.status == "Playing")
+                    return MediaPlayerRef{name, player.owner};
+            return std::nullopt;
+        }
+
+        std::string GetPlaybackStatus(const MediaPlayerRef &ref) override
+        {
+            auto it = players.find(ref.name);
+            return it != players.end() && it->second.owner == ref.owner ? it->second.status : "";
+        }
+
+        bool Pause(const MediaPlayerRef &ref) override
+        {
+            players.at(ref.name).pauses++;
+            if (beforePauseAnswer)
+                beforePauseAnswer();
+            Report(ref.name, "Paused");
+            ProcessStatusReports();
+            return true;
+        }
+
+        bool Play(const MediaPlayerRef &ref) override
+        {
+            players.at(ref.name).plays++;
+            Report(ref.name, "Playing");
+            ProcessStatusReports();
+            return true;
+        }
+
+        size_t SubscribeStatusChanged(StatusListener listener) override
+        {
+            listeners.emplace(++nextId, std::move(listener));
+            return nextId;
+        }
+
+        void UnsubscribeStatusChanged(size_t id) override { listeners.erase(id); }
+    };
+
+    // One player playing, buds in, default policy.
+    struct Fixture
+    {
+        FakeMediaPlayers players{};
+        EarPauseController controller{players};
+
+        explicit Fixture(EarPausePolicy policy = EarPausePolicy::OneRemoved, const std::string &status = "Playing")
+        {
+            players.Add("org.mpris.MediaPlayer2.music", ":1.10", status);
+            controller.SetPolicy(policy);
+        }
+
+        FakeMediaPlayers::Player &music() { return players.Get("org.mpris.MediaPlayer2.music"); }
+        void Ears(AapEarState primary, AapEarState secondary) { controller.OnEarStateChanged(primary, secondary); }
+    };
+}
+
+bool TestsAapEarDetection::TestParseEarDetection()
+{
+    auto both = AapEarDetection::Parse({0x04, 0x00, 0x04, 0x00, 0x06, 0x00, 0x00, 0x00});
+    auto out = AapEarDetection::Parse({0x04, 0x00, 0x04, 0x00, 0x06, 0x00, 0x01, 0x00});
+    auto inCase = AapEarDetection::Parse({0x04, 0x00, 0x04, 0x00, 0x06, 0x00, 0x00, 0x02});
+    auto unknown = AapEarDetection::Parse({0x04, 0x00, 0x04, 0x00, 0x06, 0x00, 0x03, 0x01});
+    return both.has_value() && both->primary == In && both->secondary == In &&
+           out.has_value() && out->primary == Out && out->secondary == In &&
+           inCase.has_value() && inCase->primary == In && inCase->secondary == Case &&
+           unknown.has_value() && unknown->primary == Gone && unknown->secondary == Out;
+}
+
+bool TestsAapEarDetection::TestParseEarDetectionRejects()
+{
+    // Too short, another packet type (battery, settings), another header.
+    return !AapEarDetection::Parse({0x04, 0x00, 0x04, 0x00, 0x06, 0x00, 0x00}).has_value() &&
+           !AapEarDetection::Parse({0x04, 0x00, 0x04, 0x00, 0x04, 0x00, 0x00, 0x00}).has_value() &&
+           !AapEarDetection::Parse({0x04, 0x00, 0x04, 0x00, 0x09, 0x00, 0x00, 0x00}).has_value() &&
+           !AapEarDetection::Parse({0x01, 0x00, 0x04, 0x00, 0x06, 0x00, 0x00, 0x00}).has_value() &&
+           !AapEarDetection::Parse({}).has_value();
+}
+
+bool TestsAapEarDetection::TestParsePrimaryBud()
+{
+    // Right, left, case: right is primary.
+    std::vector<unsigned char> rightFirst{0x04, 0x00, 0x04, 0x00, 0x04, 0x00, 0x03,
+                                          0x02, 0x01, 0x50, 0x02, 0x01,
+                                          0x04, 0x01, 0x46, 0x02, 0x01,
+                                          0x08, 0x01, 0x28, 0x02, 0x01};
+    std::vector<unsigned char> leftFirst{0x04, 0x00, 0x04, 0x00, 0x04, 0x00, 0x02,
+                                         0x04, 0x01, 0x46, 0x02, 0x01,
+                                         0x02, 0x01, 0x50, 0x02, 0x01};
+    // The case first: the first bud after it decides.
+    std::vector<unsigned char> caseFirst{0x04, 0x00, 0x04, 0x00, 0x04, 0x00, 0x02,
+                                         0x08, 0x01, 0x28, 0x02, 0x01,
+                                         0x04, 0x01, 0x46, 0x02, 0x01};
+    std::vector<unsigned char> single{0x04, 0x00, 0x04, 0x00, 0x04, 0x00, 0x01,
+                                      0x01, 0x01, 0x50, 0x02, 0x01};
+    std::vector<unsigned char> truncated{0x04, 0x00, 0x04, 0x00, 0x04, 0x00, 0x01, 0x02, 0x01, 0x50};
+    std::vector<unsigned char> earPacket{0x04, 0x00, 0x04, 0x00, 0x06, 0x00, 0x00, 0x00};
+    return AapParsePrimaryBud(rightFirst) == AapPrimaryBud::Right &&
+           AapParsePrimaryBud(leftFirst) == AapPrimaryBud::Left &&
+           AapParsePrimaryBud(caseFirst) == AapPrimaryBud::Left &&
+           AapParsePrimaryBud(single) == AapPrimaryBud::Single &&
+           !AapParsePrimaryBud(truncated).has_value() &&
+           !AapParsePrimaryBud(earPacket).has_value();
+}
+
+bool TestsAapEarDetection::TestEarStateNames()
+{
+    return AapEarStateToString(In) == "inEar" && AapEarStateToString(Out) == "outOfEar" &&
+           AapEarStateToString(Case) == "inCase" && AapEarStateToString(Gone) == "unknown";
+}
+
+bool TestsAapEarDetection::TestPolicyStrings()
+{
+    return EarPausePolicyFromString("off") == EarPausePolicy::Off &&
+           EarPausePolicyFromString("oneRemoved") == EarPausePolicy::OneRemoved &&
+           EarPausePolicyFromString("bothRemoved") == EarPausePolicy::BothRemoved &&
+           !EarPausePolicyFromString("OneRemoved").has_value() &&
+           !EarPausePolicyFromString("").has_value() &&
+           EarPausePolicyToString(EarPausePolicy::Off) == "off" &&
+           EarPausePolicyToString(EarPausePolicy::OneRemoved) == "oneRemoved" &&
+           EarPausePolicyToString(EarPausePolicy::BothRemoved) == "bothRemoved";
+}
+
+bool TestsAapEarDetection::TestFirstStateDoesNothing()
+{
+    // Connecting with the buds out (or in) is not a change.
+    Fixture f{};
+    f.Ears(Out, Out);
+    f.Ears(In, In);
+    return f.music().pauses == 0 && f.music().plays == 0 && f.music().status == "Playing";
+}
+
+bool TestsAapEarDetection::TestPauseWhenOneRemoved()
+{
+    Fixture f{};
+    f.Ears(In, In);
+    f.Ears(Out, In);
+    auto paused = f.controller.GetPausedPlayer();
+    return f.music().pauses == 1 && f.music().status == "Paused" && paused.has_value() &&
+           paused->name == "org.mpris.MediaPlayer2.music" && paused->owner == ":1.10";
+}
+
+bool TestsAapEarDetection::TestResumeSamePlayer()
+{
+    Fixture f{};
+    f.players.Add("org.mpris.MediaPlayer2.other", ":1.20", "Paused");
+    f.Ears(In, In);
+    f.Ears(In, Out);
+    // The AirPods swap primary and report again: nothing more happens.
+    f.Ears(Out, In);
+    f.Ears(In, In);
+    return f.music().pauses == 1 && f.music().plays == 1 && f.music().status == "Playing" &&
+           f.players.Get("org.mpris.MediaPlayer2.other").plays == 0 && !f.controller.GetPausedPlayer().has_value();
+}
+
+bool TestsAapEarDetection::TestUserPausedNotResumed()
+{
+    // The user paused before taking a bud out: nothing to pause, nothing to
+    // resume.
+    Fixture f{EarPausePolicy::OneRemoved, "Paused"};
+    f.Ears(In, In);
+    f.Ears(Out, In);
+    f.Ears(In, In);
+    return f.music().pauses == 0 && f.music().plays == 0 && f.music().status == "Paused";
+}
+
+bool TestsAapEarDetection::TestUserTookOverNotResumed()
+{
+    // We paused; the user played it again with one bud out, then paused it
+    // themselves. Putting the bud back must not resume it.
+    Fixture f{};
+    f.Ears(In, In);
+    f.Ears(Out, In);
+    f.players.Report("org.mpris.MediaPlayer2.music", "Playing");
+    const bool forgotten = !f.controller.GetPausedPlayer().has_value();
+    f.players.Report("org.mpris.MediaPlayer2.music", "Paused");
+    f.Ears(In, In);
+    return forgotten && f.music().pauses == 1 && f.music().plays == 0 && f.music().status == "Paused";
+}
+
+bool TestsAapEarDetection::TestOwnPauseSignalKeepsResume()
+{
+    // The player reporting the pause we asked for, and another player
+    // starting, change nothing.
+    Fixture f{};
+    f.players.Add("org.mpris.MediaPlayer2.other", ":1.20", "Paused");
+    f.Ears(In, In);
+    f.Ears(Out, In);
+    f.players.Report("org.mpris.MediaPlayer2.music", "Paused");
+    f.players.Report("org.mpris.MediaPlayer2.other", "Playing");
+    f.Ears(In, In);
+    return f.music().plays == 1 && f.music().status == "Playing" && f.players.Get("org.mpris.MediaPlayer2.other").plays == 0;
+}
+
+bool TestsAapEarDetection::TestReportBeforePauseIgnored()
+{
+    // Reports the player sent before it answered our Pause are older than
+    // the pause; they must not cancel the resume. Here a "Playing" (say,
+    // from the previous resume) reaches us only while we wait for that
+    // answer, so Pause() delivers it.
+    Fixture f{};
+    f.Ears(In, In);
+    f.players.beforePauseAnswer = [&f]() { f.players.Report("org.mpris.MediaPlayer2.music", "Playing"); };
+    f.Ears(Out, In);
+    const bool kept = f.controller.GetPausedPlayer().has_value();
+    f.Ears(In, In);
+    return kept && f.music().pauses == 1 && f.music().plays == 1 && f.music().status == "Playing";
+}
+
+bool TestsAapEarDetection::TestNotResumedUnlessStillPaused()
+{
+    // Stopped without a report reaching us, or quit and started again
+    // under another owner: not resumed.
+    Fixture stopped{};
+    stopped.Ears(In, In);
+    stopped.Ears(Out, In);
+    stopped.music().status = "Stopped";
+    stopped.Ears(In, In);
+
+    Fixture restarted{};
+    restarted.Ears(In, In);
+    restarted.Ears(Out, In);
+    restarted.music().owner = ":1.99";
+    restarted.Ears(In, In);
+
+    return stopped.music().plays == 0 && !stopped.controller.GetPausedPlayer().has_value() &&
+           restarted.music().plays == 0 && !restarted.controller.GetPausedPlayer().has_value();
+}
+
+bool TestsAapEarDetection::TestBudIntoCase()
+{
+    // Straight from the ear into the case pauses; back in the ear resumes.
+    Fixture f{};
+    f.Ears(In, In);
+    f.Ears(In, Case);
+    const bool paused = f.music().pauses == 1 && f.music().status == "Paused";
+    f.Ears(In, Out); // out of the case, in the hand: not yet
+    const bool waiting = f.music().plays == 0;
+    f.Ears(In, In);
+    return paused && waiting && f.music().plays == 1 && f.music().status == "Playing";
+}
+
+bool TestsAapEarDetection::TestOneBudListening()
+{
+    // One bud stays in the case and the user listens with the other: taking
+    // that one out pauses, putting it back resumes.
+    Fixture f{};
+    f.Ears(In, Case);
+    f.Ears(Out, Case);
+    const bool paused = f.music().pauses == 1;
+    f.Ears(In, Case);
+    return paused && f.music().plays == 1 && f.music().status == "Playing";
+}
+
+bool TestsAapEarDetection::TestBothOutThenOneBack()
+{
+    // One removed: pause at the first bud, resume only when both are back.
+    Fixture one{};
+    one.Ears(In, In);
+    one.Ears(Out, In);
+    one.Ears(Out, Out);
+    one.Ears(In, Out);
+    const bool oneWaits = one.music().pauses == 1 && one.music().plays == 0 && one.controller.GetPausedPlayer().has_value();
+    one.Ears(In, In);
+    const bool oneResumed = one.music().plays == 1 && one.music().status == "Playing";
+
+    // Both removed: pause when the second goes, resume when one is back.
+    Fixture both{EarPausePolicy::BothRemoved};
+    both.Ears(In, In);
+    both.Ears(Out, In);
+    both.Ears(Out, Out);
+    const bool bothPaused = both.music().pauses == 1;
+    both.Ears(In, Out);
+    return oneWaits && oneResumed && bothPaused && both.music().plays == 1 && both.music().status == "Playing";
+}
+
+bool TestsAapEarDetection::TestBothRemovedPolicy()
+{
+    Fixture f{EarPausePolicy::BothRemoved};
+    f.Ears(In, In);
+    f.Ears(In, Out);
+    f.Ears(In, Case);
+    const bool notYet = f.music().pauses == 0 && f.music().status == "Playing";
+    f.Ears(Out, Case);
+    const bool paused = f.music().pauses == 1;
+    f.Ears(Out, In);
+    return notYet && paused && f.music().plays == 1;
+}
+
+bool TestsAapEarDetection::TestPolicyOff()
+{
+    Fixture off{EarPausePolicy::Off};
+    off.Ears(In, In);
+    off.Ears(Out, Out);
+    off.Ears(In, In);
+
+    // Turned off while we hold a paused player: it is forgotten.
+    Fixture turnedOff{};
+    turnedOff.Ears(In, In);
+    turnedOff.Ears(Out, In);
+    turnedOff.controller.SetPolicy(EarPausePolicy::Off);
+    turnedOff.controller.SetPolicy(EarPausePolicy::OneRemoved);
+    turnedOff.Ears(In, In);
+
+    return off.music().pauses == 0 && off.music().plays == 0 &&
+           turnedOff.music().pauses == 1 && turnedOff.music().plays == 0;
+}
+
+bool TestsAapEarDetection::TestDisconnectForgets()
+{
+    Fixture f{};
+    f.Ears(In, In);
+    f.Ears(Out, In);
+    f.controller.Reset();
+    // After reconnecting, the first state is not a change.
+    f.Ears(Out, In);
+    f.Ears(In, In);
+    return f.music().pauses == 1 && f.music().plays == 0 && f.music().status == "Paused";
+}
+
+bool TestsAapEarDetection::TestUnknownBudDoesNotPause()
+{
+    // A bud that runs flat or drops its link reports neither in nor out.
+    Fixture f{};
+    f.Ears(In, In);
+    f.Ears(In, Gone);
+    const bool notPaused = f.music().pauses == 0;
+    // The remaining bud taken out still pauses.
+    f.Ears(Out, Gone);
+    return notPaused && f.music().pauses == 1;
+}
+
+bool TestsAapEarDetection::TestSingleBud()
+{
+    // AirPods Max: only the primary state counts.
+    Fixture f{};
+    f.controller.SetSingleBud(true);
+    f.Ears(In, Out);
+    f.Ears(In, In);
+    const bool secondaryIgnored = f.music().pauses == 0;
+    f.Ears(Out, In);
+    const bool paused = f.music().pauses == 1;
+    f.Ears(In, Out);
+    return secondaryIgnored && paused && f.music().plays == 1;
+}
+
+bool TestsAapEarDetection::TestPausesOnlyPlayingPlayer()
+{
+    // The paused "aaa" sorts first; only the playing one is paused.
+    Fixture f{};
+    f.players.Add("org.mpris.MediaPlayer2.aaa", ":1.5", "Paused");
+    f.Ears(In, In);
+    f.Ears(Out, In);
+    f.Ears(In, In);
+    auto &other = f.players.Get("org.mpris.MediaPlayer2.aaa");
+    return other.pauses == 0 && other.plays == 0 && other.status == "Paused" && f.music().pauses == 1 &&
+           f.music().plays == 1;
+}
+
+void TestsAapEarDetection::Test(const char *name, bool b)
+{
+    int spaceCount = 50 - static_cast<int>(std::strlen(name));
+    std::string space(spaceCount > 0 ? spaceCount : 1, ' ');
+    Logger::Debug("%s%s: %s", name, space.c_str(), b ? "PASS" : "FAIL");
+}
+
+TestsAapEarDetection::TestsAapEarDetection()
+{
+    Test("TestParseEarDetection", TestParseEarDetection());
+    Test("TestParseEarDetectionRejects", TestParseEarDetectionRejects());
+    Test("TestParsePrimaryBud", TestParsePrimaryBud());
+    Test("TestEarStateNames", TestEarStateNames());
+    Test("TestPolicyStrings", TestPolicyStrings());
+    Test("TestFirstStateDoesNothing", TestFirstStateDoesNothing());
+    Test("TestPauseWhenOneRemoved", TestPauseWhenOneRemoved());
+    Test("TestResumeSamePlayer", TestResumeSamePlayer());
+    Test("TestUserPausedNotResumed", TestUserPausedNotResumed());
+    Test("TestUserTookOverNotResumed", TestUserTookOverNotResumed());
+    Test("TestOwnPauseSignalKeepsResume", TestOwnPauseSignalKeepsResume());
+    Test("TestReportBeforePauseIgnored", TestReportBeforePauseIgnored());
+    Test("TestNotResumedUnlessStillPaused", TestNotResumedUnlessStillPaused());
+    Test("TestBudIntoCase", TestBudIntoCase());
+    Test("TestOneBudListening", TestOneBudListening());
+    Test("TestBothOutThenOneBack", TestBothOutThenOneBack());
+    Test("TestBothRemovedPolicy", TestBothRemovedPolicy());
+    Test("TestPolicyOff", TestPolicyOff());
+    Test("TestDisconnectForgets", TestDisconnectForgets());
+    Test("TestUnknownBudDoesNotPause", TestUnknownBudDoesNotPause());
+    Test("TestSingleBud", TestSingleBud());
+    Test("TestPausesOnlyPlayingPlayer", TestPausesOnlyPlayingPlayer());
+}
