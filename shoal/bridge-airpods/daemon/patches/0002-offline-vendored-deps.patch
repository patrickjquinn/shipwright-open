From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shipwright <shipwright@invalid>
Date: Wed, 30 Sep 2026 20:57:56 +0000
Subject: [PATCH] Allow offline builds from local dependency archives

All five dependencies are fetched at configure time, which fails on
build hosts without network access (OBS, distribution builders).

Add MAGICPODS_DEPENDENCY_DIR: when it names a directory holding the
source archive of a dependency, that archive is used instead of the
download, and is verified against a pinned SHA256. The archives are
`git archive` tarballs of the same tags upstream already pins
(prefix <name>-<version>/, gzip -n), except nlohmann/json, which uses
its release asset json.tar.xz, the file its README recommends for
FetchContent.

MAGICPODS_OFFLINE=ON turns a missing archive into a configure error, so
a packaging build can never fall back to the network silently.

Without either option nothing changes: the same URLs and git tags as
before are used.

  sdbus-c++    1.6.0    sdbus-cpp-1.6.0.tar.gz        (tag commit 7450515d)
  uWebSockets  20.58.0  uWebSockets-20.58.0.tar.gz    (tag commit fc2b7be7)
  uSockets     0.8.7    uSockets-0.8.7.tar.gz         (tag commit a15d9bbd)
  nlohmann     3.11.3   nlohmann-json-3.11.3.tar.xz   (release asset)
  toml++       3.4.0    tomlplusplus-3.4.0.tar.gz     (tag commit 30172438)
---
 dependencies/CMakeLists.txt             | 39 +++++++++++++++++++++++++
 dependencies/json/CMakeLists.txt        |  7 +++--
 dependencies/sdbus-cpp/CMakeLists.txt   |  9 +++---
 dependencies/toml++/CMakeLists.txt      |  7 +++--
 dependencies/uSockets/CMakeLists.txt    | 14 +++++----
 dependencies/uWebSockets/CMakeLists.txt | 14 +++++----
 6 files changed, 68 insertions(+), 22 deletions(-)

diff --git a/dependencies/CMakeLists.txt b/dependencies/CMakeLists.txt
index 8e9e3aa..5165f11 100644
--- a/dependencies/CMakeLists.txt
+++ b/dependencies/CMakeLists.txt
@@ -1,3 +1,42 @@
+include(FetchContent)
+
+# Offline builds.
+#
+# By default each dependency is downloaded at configure time. Packagers whose
+# build hosts have no network access (OBS, distribution builders) can instead
+# point MAGICPODS_DEPENDENCY_DIR at a directory holding the source archives
+# named below; an archive found there is used instead of the download and is
+# checked against its SHA256. The archives are `git archive` tarballs of the
+# pinned tags (prefix <name>-<version>/, gzip -n), except nlohmann/json,
+# which is its release asset json.tar.xz.
+#
+# MAGICPODS_OFFLINE=ON turns a missing archive into a configure error instead
+# of a silent download.
+set(MAGICPODS_DEPENDENCY_DIR "" CACHE PATH "Directory holding dependency source archives for offline builds")
+option(MAGICPODS_OFFLINE "Fail if a dependency archive is missing from MAGICPODS_DEPENDENCY_DIR instead of downloading it" OFF)
+
+if(POLICY CMP0135)
+    # Extracted files get the extraction time as timestamp.
+    cmake_policy(SET CMP0135 NEW)
+endif()
+
+# magicpods_declare_dependency(<name> ARCHIVE <file> SHA256 <hash> REMOTE <FetchContent_Declare arguments...>)
+function(magicpods_declare_dependency name)
+    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "ARCHIVE;SHA256" "REMOTE")
+    if(MAGICPODS_DEPENDENCY_DIR AND EXISTS "${MAGICPODS_DEPENDENCY_DIR}/${ARG_ARCHIVE}")
+        message(STATUS "${name}: using ${MAGICPODS_DEPENDENCY_DIR}/${ARG_ARCHIVE}")
+        FetchContent_Declare(${name}
+            URL "${MAGICPODS_DEPENDENCY_DIR}/${ARG_ARCHIVE}"
+            URL_HASH SHA256=${ARG_SHA256}
+        )
+    elseif(MAGICPODS_OFFLINE)
+        message(FATAL_ERROR "MAGICPODS_OFFLINE is ON but ${ARG_ARCHIVE} is not in "
+                            "MAGICPODS_DEPENDENCY_DIR ('${MAGICPODS_DEPENDENCY_DIR}')")
+    else()
+        FetchContent_Declare(${name} ${ARG_REMOTE})
+    endif()
+endfunction()
+
 add_subdirectory(sdbus-cpp)
 add_subdirectory(uSockets)
 add_subdirectory(uWebSockets)
