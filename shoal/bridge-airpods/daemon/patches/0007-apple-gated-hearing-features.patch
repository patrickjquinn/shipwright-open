new file mode 100644
index 0000000..be4aa29
--- /dev/null
+++ b/src/device/capabilities/aap/AapAttCapability.h
@@ -0,0 +1,35 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include "AapAppleGatedCapability.h"
+#include "sdk/aap/att/AapAttHandles.h"
+
+namespace MagicPodsCore
+{
+    // An Apple-gated capability backed by one attribute on the ATT channel.
+    // It reads the attribute when the channel comes up, subscribes to its
+    // notifications if it has them, and re-reads it after each write.
+    class AapAttCapability : public AapAppleGatedCapability
+    {
+    private:
+        AapAttHandle _handle;
+        bool _notifies;
+
+    protected:
+        std::vector<unsigned char> raw{};
+
+        void WriteValue(const std::vector<unsigned char> &value);
+        // New value of the attribute (read response or notification). Returns
+        // false to refuse a value that is not valid for this attribute; raw
+        // then keeps the last valid value.
+        virtual bool OnAttValue(const std::vector<unsigned char> &value) = 0;
+        void OnReceivedData(const std::vector<unsigned char> &data) override {}
+        void ResetData() override { raw.clear(); }
+
+    public:
+        AapAttCapability(const std::string &name, AapDevice &device, AapAttHandle handle, bool notifies);
+    };
+}
diff --git a/src/device/capabilities/aap/AapHearingAidAdjustmentsCapability.cpp b/src/device/capabilities/aap/AapHearingAidAdjustmentsCapability.cpp
new file mode 100644
index 0000000..badf8a4
--- /dev/null
+++ b/src/device/capabilities/aap/AapHearingAidAdjustmentsCapability.cpp
@@ -0,0 +1,47 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "AapHearingAidAdjustmentsCapability.h"
+
+namespace MagicPodsCore
+{
+    AapHearingAidAdjustmentsCapability::AapHearingAidAdjustmentsCapability(AapDevice &device)
+        : AapAttCapability("hearingAidAdjustments", device, AapAttHandle::HearingAid, true)
+    {
+    }
+
+    nlohmann::json AapHearingAidAdjustmentsCapability::CreateAvailableJsonBody()
+    {
+        auto body = nlohmann::json::object();
+        AapHearingSettings::AdjustmentsToJson(AapHearingSettings::ToAdjustments(settings.left, settings.right), body);
+        return body;
+    }
+
+    bool AapHearingAidAdjustmentsCapability::OnAttValue(const std::vector<unsigned char> &value)
+    {
+        auto parsed = AapHearingSettings::ParseHearingAid(value);
+        if (!parsed.has_value()) {
+            Logger::Warn("%s: ignoring a value that is not a hearing aid attribute (%zu bytes)", name.c_str(), value.size());
+            return false;
+        }
+        settings = parsed.value();
+        Logger::Info("%s updated", name.c_str());
+        DataUpdated();
+        return true;
+    }
+
+    void AapHearingAidAdjustmentsCapability::SetAvailableFromJson(const nlohmann::json &body)
+    {
+        if (!hasData) {
+            Logger::Error("Error: %s::SetFromJson: the attribute has not been read yet", name.c_str());
+            return;
+        }
+        auto next = raw;
+        if (!AapHearingSettings::ApplyToHearingAid(body, next)) {
+            Logger::Error("Error: %s::SetFromJson got a value of the wrong type or out of range", name.c_str());
+            return;
+        }
+        WriteValue(next);
+    }
+}
