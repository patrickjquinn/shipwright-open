@@ -0,0 +1,65 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "AapHearingAidCapability.h"
+#include "sdk/aap/AapControlCommand.h"
+#include "sdk/aap/enums/AapModelIds.h"
+
+namespace MagicPodsCore
+{
+    AapHearingAidCapability::AapHearingAidCapability(AapDevice &device)
+        : AapAppleGatedCapability("hearingAid", false, device)
+    {
+    }
+
+    bool AapHearingAidCapability::Supports(unsigned short productId)
+    {
+        // LibrePods lists the hearing aid for AirPods Pro 2 (Lightning and
+        // USB-C) and AirPods Pro 3.
+        switch (static_cast<AapModelIds>(productId)) {
+            case AapModelIds::airpodspro2:
+            case AapModelIds::airpodsprousbc:
+            case AapModelIds::airpodspro3:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    nlohmann::json AapHearingAidCapability::CreateAvailableJsonBody()
+    {
+        return nlohmann::json{{"selected", enabled}, {"enrolled", enrolled}};
+    }
+
+    void AapHearingAidCapability::OnReceivedData(const std::vector<unsigned char> &data)
+    {
+        auto command = AapControlCommand::Parse(data);
+        if (!command.has_value() || command->identifier != static_cast<unsigned char>(AapControlId::HearingAid))
+            return;
+
+        const bool newEnrolled = command->data1 == 0x01;
+        const bool newEnabled = command->data2 == 0x01;
+        if (hasData && newEnrolled == enrolled && newEnabled == enabled)
+            return;
+        enrolled = newEnrolled;
+        enabled = newEnabled;
+        Logger::Info("%s updated: enrolled %d, enabled %d", name.c_str(), enrolled, enabled);
+        DataUpdated();
+    }
+
+    void AapHearingAidCapability::SetAvailableFromJson(const nlohmann::json &body)
+    {
+        if (!body.contains("selected") || !body["selected"].is_boolean()) {
+            Logger::Error("Error: %s::SetFromJson got no value or value is not an boolean", name.c_str());
+            return;
+        }
+        const bool selected = body["selected"].get<bool>();
+        if (selected && !enrolled) {
+            Logger::Info("%s: refused, the headphones hold no audiogram", name.c_str());
+            return;
+        }
+        SendData(AapSetControl(AapControlId::HearingAid, 0x01, selected ? 0x01 : 0x02));
+        SendData(AapSetControl(AapControlId::HearingAssist, selected ? 0x01 : 0x02));
+    }
+}
