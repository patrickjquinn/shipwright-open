+        DataUpdated();
+        return true;
+    }
+
+    void AapTransparencyCustomCapability::SetAvailableFromJson(const nlohmann::json &body)
+    {
+        if (!hasData) {
+            Logger::Error("Error: %s::SetFromJson: the attribute has not been read yet", name.c_str());
+            return;
