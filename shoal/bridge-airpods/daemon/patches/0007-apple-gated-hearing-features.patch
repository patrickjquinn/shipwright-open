+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "AapAttChannel.h"
+#include "client/Client.h"
+#include "sdk/aap/att/AttPdu.h"
+#include "Logger.h"
+#include "StringUtils.h"
+
+namespace MagicPodsCore
+{
+    namespace
+    {
+        class ClientAttTransport : public AttTransport
+        {
+        private:
+            std::unique_ptr<Client> _client;
+
+        public:
+            explicit ClientAttTransport(const std::string& address) : _client{Client::CreateL2CAP(address, Att::PSM)} {}
+
+            void Start() override { _client->Start(); }
+            void Stop() override { _client->Stop(); }
+            bool IsStarted() const override { return _client->IsStarted(); }
+            void SendData(const std::vector<unsigned char>& data) override { _client->SendData(data); }
+            Event<std::vector<unsigned char>>& GetOnReceivedDataEvent() override { return _client->GetOnReceivedDataEvent(); }
+            Event<std::string>& GetOnConnectionLostEvent() override { return _client->GetOnConnectionLostEvent(); }
+        };
+
+        // Whether pdu is the answer to a request with this opcode and handle.
+        bool Answers(const Att::Pdu& pdu, unsigned char requestOpcode, uint16_t requestHandle)
+        {
+            switch (pdu.opcode) {
+                case Att::Opcode::ReadResponse:
+                    return requestOpcode == static_cast<unsigned char>(Att::Opcode::ReadRequest);
+                case Att::Opcode::WriteResponse:
+                    return requestOpcode == static_cast<unsigned char>(Att::Opcode::WriteRequest);
+                case Att::Opcode::ErrorResponse:
+                    // request opcode, handle, error code
+                    return !pdu.value.empty() && pdu.value[0] == requestOpcode && pdu.handle == requestHandle;
+                default:
+                    return false;
+            }
+        }
+    }
+
+    AapAttChannel::AapAttChannel(const std::string& address)
+        : AapAttChannel(std::make_unique<ClientAttTransport>(address))
+    {
+    }
+
+    AapAttChannel::AapAttChannel(std::unique_ptr<AttTransport> transport, std::chrono::milliseconds requestTimeout)
+        : _transport{std::move(transport)}, _requestTimeout{requestTimeout}
+    {
+        _receivedEventId = _transport->GetOnReceivedDataEvent().Subscribe([this](size_t id, const std::vector<unsigned char>& data) {
+            OnData(data);
+        });
+        _lostEventId = _transport->GetOnConnectionLostEvent().Subscribe([this](size_t id, const std::string& address) {
+            OnConnectionLost();
+        });
+    }
+
+    AapAttChannel::~AapAttChannel()
+    {
+        Stop();
+        _transport->GetOnReceivedDataEvent().Unsubscribe(_receivedEventId);
+        _transport->GetOnConnectionLostEvent().Unsubscribe(_lostEventId);
+    }
+
+    bool AapAttChannel::Start(const std::function<bool()>& stillWanted)
+    {
+        std::lock_guard lifecycle{_lifecycleMutex};
+        if (stillWanted && !stillWanted())
+            return false;
+        if (_transport->IsStarted())
+            return true;
+
+        // The watchdog of a connection that closed on its own.
+        JoinWatchdog();
+        {
+            std::lock_guard lock{_mutex};
+            DropPendingLocked();
+        }
+
+        _transport->Start();
+        if (!_transport->IsStarted()) {
+            Logger::Info("ATT channel failed to connect");
+            return false;
+        }
+        // Stop() waited while this connected; honour what it wanted.
+        if (stillWanted && !stillWanted()) {
+            Logger::Info("ATT channel connected but no longer wanted");
+            StopLocked();
+            return false;
+        }
+
+        {
+            std::lock_guard lock{_mutex};
+            _watchdogRunning = true;
+        }
+        _watchdog = std::thread([this]() { WatchdogLoop(); });
+
+        Logger::Info("ATT channel connected");
+        _onStarted.FireEvent(true);
+        return true;
+    }
+
+    void AapAttChannel::Stop()
+    {
+        std::lock_guard lifecycle{_lifecycleMutex};
+        StopLocked();
+    }
+
+    void AapAttChannel::StopLocked()
+    {
+        {
+            std::lock_guard lock{_mutex};
+            _watchdogRunning = false;
+            DropPendingLocked();
+        }
+        _wake.notify_all();
+        _transport->Stop();
+        JoinWatchdog();
+    }
+
+    void AapAttChannel::JoinWatchdog()
+    {
+        if (!_watchdog.joinable())
+            return;
+        // Start() or Stop() called from an event fired by the watchdog itself:
+        // it is about to return, so let it go.
+        if (_watchdog.get_id() == std::this_thread::get_id())
+            _watchdog.detach();
+        else
+            _watchdog.join();
+    }
+
+    bool AapAttChannel::IsStarted() const
+    {
+        return _transport->IsStarted();
+    }
+
+    void AapAttChannel::Read(uint16_t handle)
+    {
+        Enqueue({Att::ReadRequest(handle), static_cast<unsigned char>(Att::Opcode::ReadRequest), handle});
+    }
+
+    void AapAttChannel::Write(uint16_t handle, const std::vector<unsigned char>& value)
+    {
+        Enqueue({Att::WriteRequest(handle, value), static_cast<unsigned char>(Att::Opcode::WriteRequest), handle});
+    }
+
+    void AapAttChannel::EnableNotifications(uint16_t handle)
+    {
+        Enqueue({Att::EnableNotifications(handle), static_cast<unsigned char>(Att::Opcode::WriteRequest), static_cast<uint16_t>(handle + 1)});
+    }
+
+    void AapAttChannel::Enqueue(Request request)
+    {
+        if (!_transport->IsStarted()) {
+            Logger::Debug("ATT channel not connected, dropping request for handle 0x%04x", request.handle);
+            return;
+        }
+
+        std::lock_guard lock{_mutex};
+        _queue.push_back(std::move(request));
+        if (!_waiting)
+            SendNextLocked();
+    }
+
+    void AapAttChannel::SendNextLocked()
+    {
+        if (_queue.empty())
+            return;
+        _inFlight = std::move(_queue.front());
+        _queue.pop_front();
+        _waiting = true;
+        _sentAt = std::chrono::steady_clock::now();
+        _transport->SendData(_inFlight.pdu);
+        // The watchdog waits for the new deadline.
+        _wake.notify_all();
+    }
+
+    std::vector<uint16_t> AapAttChannel::DropPendingLocked()
+    {
+        std::vector<uint16_t> handles{};
+        if (_waiting)
+            handles.push_back(_inFlight.handle);
+        for (const auto& request : _queue)
+            handles.push_back(request.handle);
+        _queue.clear();
+        _waiting = false;
+        _inFlight = Request{};
+        return handles;
+    }
+
+    void AapAttChannel::FailRequests(const std::vector<uint16_t>& handles)
+    {
+        for (uint16_t handle : handles)
+            _onError.FireEvent(handle);
+    }
+
+    void AapAttChannel::WatchdogLoop()
+    {
+        std::unique_lock lock{_mutex};
+        while (_watchdogRunning) {
+            if (!_waiting) {
+                _wake.wait(lock);
+                continue;
+            }
+            const auto deadline = _sentAt + _requestTimeout;
+            if (std::chrono::steady_clock::now() < deadline) {
+                _wake.wait_until(lock, deadline);
+                continue;
+            }
+
+            const uint16_t handle = _inFlight.handle;
+            const auto failed = DropPendingLocked();
+            _watchdogRunning = false;
+            lock.unlock();
+
+            Logger::Warn("ATT request for handle 0x%04x got no response; closing the channel", handle);
+            _transport->Stop();
+            FailRequests(failed);
+            _onClosed.FireEvent(true);
+            return;
+        }
+    }
+
+    void AapAttChannel::OnConnectionLost()
+    {
+        std::vector<uint16_t> failed{};
+        {
+            std::lock_guard lock{_mutex};
+            _watchdogRunning = false;
+            failed = DropPendingLocked();
+        }
+        _wake.notify_all();
+        Logger::Info("ATT channel lost");
+        FailRequests(failed);
+        _onClosed.FireEvent(false);
+    }
+
+    void AapAttChannel::OnData(const std::vector<unsigned char>& data)
+    {
+        auto pdu = Att::Parse(data);
+        if (!pdu.has_value())
+            return;
+
+        const unsigned char opcode = static_cast<unsigned char>(pdu->opcode);
+
+        switch (pdu->opcode) {
+            case Att::Opcode::HandleValueNotification:
+                _onValue.FireEvent(AttValue{pdu->handle, pdu->value});
+                return;
+            case Att::Opcode::HandleValueIndication:
+                _transport->SendData(Att::HandleValueConfirmation());
+                _onValue.FireEvent(AttValue{pdu->handle, pdu->value});
+                return;
+            case Att::Opcode::ExchangeMtuRequest:
+                _transport->SendData(Att::ExchangeMtuResponse(LocalMtu));
+                return;
+            default:
+                break;
+        }
+
+        if (Att::IsRequestFromPeer(opcode)) {
+            // We serve no attributes of our own.
+            _transport->SendData(Att::ErrorResponse(opcode, 0x0000, Att::ErrorRequestNotSupported));
+            return;
+        }
+
+        if (pdu->opcode != Att::Opcode::ReadResponse && pdu->opcode != Att::Opcode::WriteResponse &&
+            pdu->opcode != Att::Opcode::ErrorResponse) {
+            Logger::Debug("ATT: ignoring %s", StringUtils::BytesToHexString(data.data(), data.size()).c_str());
+            return;
+        }
+
+        Request answered{};
+        {
+            std::lock_guard lock{_mutex};
+            if (!_waiting) {
+                Logger::Warn("ATT: discarding response 0x%02x, no request is in flight", opcode);
+                return;
+            }
+            if (!Answers(*pdu, _inFlight.opcode, _inFlight.handle)) {
+                Logger::Warn("ATT: discarding response 0x%02x, which does not answer request 0x%02x for handle 0x%04x",
+                             opcode, _inFlight.opcode, _inFlight.handle);
+                return;
+            }
+            answered = std::move(_inFlight);
+            _waiting = false;
+            SendNextLocked();
+        }
+
+        if (pdu->opcode == Att::Opcode::ReadResponse) {
+            _onValue.FireEvent(AttValue{answered.handle, pdu->value});
+        }
+        else if (pdu->opcode == Att::Opcode::WriteResponse) {
+            // The written value: the request PDU after opcode and handle.
+            _onWritten.FireEvent(AttValue{answered.handle, std::vector<unsigned char>(answered.pdu.begin() + 3, answered.pdu.end())});
+        }
+        else {
+            Logger::Warn("ATT error 0x%02x for handle 0x%04x", pdu->value.size() >= 4 ? pdu->value[3] : 0, answered.handle);
+            _onError.FireEvent(answered.handle);
+        }
+    }
+}
