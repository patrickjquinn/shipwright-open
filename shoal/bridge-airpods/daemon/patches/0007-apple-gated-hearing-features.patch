diff --git a/src/device/capabilities/aap/AapAppleGatedCapability.cpp b/src/device/capabilities/aap/AapAppleGatedCapability.cpp
new file mode 100644
index 0000000..be4aa4a
--- /dev/null
+++ b/src/device/capabilities/aap/AapAppleGatedCapability.cpp
@@ -0,0 +1,112 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "AapAppleGatedCapability.h"
+#include "HostDeviceId.h"
+
+namespace MagicPodsCore
+{
+    AapAppleGatedCapability::AapAppleGatedCapability(const std::string &name, bool isReadOnly, AapDevice &device)
+        : AapCapability(name, isReadOnly, device), _readOnlyWhenAvailable{isReadOnly}
+    {
+        _hostDeviceIdEventId = HostDeviceId::Instance().GetChangedEvent().Subscribe([this](size_t id, bool isApple) {
+            if (!isApple) {
+                hasData = false;
+                ResetData();
+            }
+            Refresh(true);
+        });
+
+        _gatedClientStateEventId = this->device.GetClientStateChangedEvent().Subscribe([this](size_t id, ClientState state) {
+            // Disconnected is handled by AapCapability through Reset().
+            if (state != ClientState::Disconnected)
+                Refresh(true);
+        });
+    }
+
+    AapAppleGatedCapability::~AapAppleGatedCapability()
+    {
+        // HostDeviceId outlives every device. Device events are released in ~Device.
+        HostDeviceId::Instance().GetChangedEvent().Unsubscribe(_hostDeviceIdEventId);
+    }
+
+    bool AapAppleGatedCapability::IsHostApple()
+    {
+        return HostDeviceId::Instance().IsApple();
+    }
+
+    nlohmann::json AapAppleGatedCapability::UnavailableJsonBody()
+    {
+        return nlohmann::json{{"unavailable", UnavailableReason}};
+    }
+
+    nlohmann::json AapAppleGatedCapability::CreateJsonBody()
+    {
+        if (!IsHostApple())
+            return UnavailableJsonBody();
+        return CreateAvailableJsonBody();
+    }
+
+    void AapAppleGatedCapability::Reset()
+    {
+        hasData = false;
+        ResetData();
+        Refresh(false);
+    }
+
+    void AapAppleGatedCapability::Refresh(bool notify)
+    {
+        const auto before = GetAsJson();
+
+        if (device.GetClientState() == ClientState::Disconnected) {
+            isAvailable = false;
+        }
+        else if (!IsHostApple()) {
+            isAvailable = true;
+            isReadOnly = true;
+        }
+        else {
+            isAvailable = HasData();
+            isReadOnly = _readOnlyWhenAvailable;
+        }
+
+        if (notify && GetAsJson() != before)
+            _onChanged.FireEvent(*this);
+    }
+
+    void AapAppleGatedCapability::DataUpdated()
+    {
+        // Subclasses call this only when their state changed. Without Apple's
+        // Device ID the listing does not show that state, so notify only if
+        // the capability appeared.
+        hasData = true;
+        const bool wasAvailable = isAvailable;
+        Refresh(false);
+        if (IsHostApple() ? isAvailable : isAvailable != wasAvailable)
+            _onChanged.FireEvent(*this);
+    }
+
+    void AapAppleGatedCapability::SetFromJson(const nlohmann::json &json)
+    {
+        if (!json.contains(name))
+            return;
+
+        if (!IsHostApple()) {
+            Logger::Info("%s: ignored, the host does not present Apple's Device ID", name.c_str());
+            return;
+        }
+
+        if (!isAvailable || isReadOnly) {
+            Logger::Info("%s: ignored, no state from the headphones yet", name.c_str());
+            return;
+        }
+
+        const auto &body = json.at(name);
+        if (!body.is_object()) {
+            Logger::Error("Error: %s::SetFromJson expects an object", name.c_str());
+            return;
+        }
+        SetAvailableFromJson(body);
+    }
+}
diff --git a/src/device/capabilities/aap/AapAppleGatedCapability.h b/src/device/capabilities/aap/AapAppleGatedCapability.h
new file mode 100644
index 0000000..600f82c
--- /dev/null
+++ b/src/device/capabilities/aap/AapAppleGatedCapability.h
@@ -0,0 +1,57 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include "AapCapability.h"
+#include "client/ClientState.h"
+
+namespace MagicPodsCore
+{
+    // A capability AirPods offer only to hosts whose Device ID carries Apple's
+    // company identifier (see HostDeviceId). While the AirPods are connected:
+    //
+    // - host without Apple's Device ID: the capability is listed as
+    //   {"unavailable": "needs Apple Device ID", "readonly": true}, so a client
+    //   can explain why the feature is missing, and SetCapabilities ignores it;
+    // - host with Apple's Device ID: the capability is listed once the AirPods
+    //   reported its state (HasData()), like any other capability.
+    //
+    // Subclasses add the model's product IDs to their Supports() check and are
+    // only created for models that have the feature.
+    class AapAppleGatedCapability : public AapCapability
+    {
+    private:
+        bool _readOnlyWhenAvailable;
+        size_t _hostDeviceIdEventId{};
+        size_t _gatedClientStateEventId{};
+
+    protected:
+        bool hasData = false;
+
+        static bool IsHostApple();
+        nlohmann::json CreateJsonBody() final;
+        void Reset() override;
+        // Recomputes isAvailable and isReadOnly; fires the changed event if
+        // the JSON a client would see changed and notify is set.
+        void Refresh(bool notify);
+        // For subclasses: new state from the AirPods.
+        void DataUpdated();
+
+        virtual nlohmann::json CreateAvailableJsonBody() = 0;
+        virtual void SetAvailableFromJson(const nlohmann::json &body) = 0;
+        virtual bool HasData() const { return hasData; }
+        virtual void ResetData() {}
+
+    public:
+        static constexpr const char *UnavailableReason = "needs Apple Device ID";
+
+        AapAppleGatedCapability(const std::string &name, bool isReadOnly, AapDevice &device);
+        ~AapAppleGatedCapability() override;
+        void SetFromJson(const nlohmann::json &json) final;
+
+        // The JSON body shown when the host lacks Apple's Device ID.
+        static nlohmann::json UnavailableJsonBody();
+    };
+}
diff --git a/src/device/capabilities/aap/AapAttCapability.cpp b/src/device/capabilities/aap/AapAttCapability.cpp
new file mode 100644
index 0000000..a7a7e21
--- /dev/null
+++ b/src/device/capabilities/aap/AapAttCapability.cpp
@@ -0,0 +1,47 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "AapAttCapability.h"
+#include "device/AapAttChannel.h"
+
+namespace MagicPodsCore
+{
+    AapAttCapability::AapAttCapability(const std::string &name, AapDevice &device, AapAttHandle handle, bool notifies)
+        : AapAppleGatedCapability(name, false, device), _handle{handle}, _notifies{notifies}
+    {
+        AapAttChannel *att = device.GetAttChannel();
+        if (att == nullptr)
+            return;
+
+        const auto handleValue = static_cast<uint16_t>(_handle);
+
+        // Channel events are released with the channel in ~AapDevice.
+        att->GetStartedEvent().Subscribe([this, att, handleValue](size_t id, bool started) {
+            att->Read(handleValue);
+            if (_notifies)
+                att->EnableNotifications(handleValue);
+        });
+
+        att->GetValueEvent().Subscribe([this, handleValue](size_t id, const AttValue &value) {
+            if (value.handle != handleValue || !IsHostApple())
+                return;
+            if (value.value == raw && hasData)
+                return;
+            if (OnAttValue(value.value))
+                raw = value.value;
+        });
+
+        att->GetWrittenEvent().Subscribe([this, att, handleValue](size_t id, const AttValue &value) {
+            // Read back what the AirPods kept: not every attribute notifies.
+            if (value.handle == handleValue)
+                att->Read(handleValue);
+        });
+    }
+
+    void AapAttCapability::WriteValue(const std::vector<unsigned char> &value)
+    {
+        if (AapAttChannel *att = device.GetAttChannel())
+            att->Write(static_cast<uint16_t>(_handle), value);
+    }
+}
