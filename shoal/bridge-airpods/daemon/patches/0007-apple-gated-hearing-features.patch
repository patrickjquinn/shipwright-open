+
+#include "AapControlCommand.h"
+#include "sdk/aap/enums/AapCmd.h"
+
+namespace MagicPodsCore
+{
+    std::optional<AapControlCommand> AapControlCommand::Parse(const std::vector<unsigned char> &data)
+    {
+        if (data.size() < 9 || data[4] != static_cast<unsigned char>(AapCmd::Settings))
+            return std::nullopt;
+        return AapControlCommand{data[6], data[7], data[8]};
+    }
+
+    AapSetControl::AapSetControl(AapControlId identifier, unsigned char data1, unsigned char data2)
+        : AapRequest{"AapSetControl"}, _command{static_cast<unsigned char>(identifier), data1, data2}
+    {
+    }
+
+    std::vector<unsigned char> AapSetControl::Request() const
+    {
+        return std::vector<unsigned char>{0x04, 0x00, 0x04, 0x00, static_cast<unsigned char>(AapCmd::Settings), 0x00,
+                                          _command.identifier, _command.data1, _command.data2, 0x00, 0x00};
+    }
+}
