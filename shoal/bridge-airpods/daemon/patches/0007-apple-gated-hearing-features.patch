+    AapLoudSoundReductionCapability::AapLoudSoundReductionCapability(AapDevice &device)
+        : AapAttCapability("loudSoundReduction", device, AapAttHandle::LoudSoundReduction, false)
+    {
+    }
+
+    bool AapLoudSoundReductionCapability::Supports(unsigned short productId)
+    {
+        // LibrePods lists loud sound reduction for AirPods Pro 2 (Lightning
+        // and USB-C) and AirPods Pro 3.
+        switch (static_cast<AapModelIds>(productId)) {
+            case AapModelIds::airpodspro2:
+            case AapModelIds::airpodsprousbc:
+            case AapModelIds::airpodspro3:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    nlohmann::json AapLoudSoundReductionCapability::CreateAvailableJsonBody()
+    {
+        return nlohmann::json{{"selected", option}};
+    }
+
+    bool AapLoudSoundReductionCapability::OnAttValue(const std::vector<unsigned char> &value)
+    {
+        const auto parsed = AapHearingSettings::ParseLoudSoundReduction(value);
+        if (!parsed.has_value()) {
+            Logger::Warn("%s: ignoring a value that is not a loud sound reduction attribute (%zu bytes)", name.c_str(), value.size());
+            return false;
+        }
+        if (hasData && parsed.value() == option)
+            return true;
+        option = parsed.value();
+        Logger::Info("%s updated: %s", name.c_str(), option ? "on" : "off");
+        DataUpdated();
+        return true;
+    }
+
+    void AapLoudSoundReductionCapability::SetAvailableFromJson(const nlohmann::json &body)
+    {
+        if (!body.contains("selected") || !body["selected"].is_boolean()) {
+            Logger::Error("Error: %s::SetFromJson got no value or value is not an boolean", name.c_str());
+            return;
+        }
+        // The confirmation is the read-back after the write response.
+        WriteValue({static_cast<unsigned char>(body["selected"].get<bool>() ? 0x01 : 0x00)});
+    }
+}
