+++ b/src/tests/TestsAapAppleGated.cpp
@@ -0,0 +1,478 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "TestsAapAppleGated.h"
+#include "HostDeviceId.h"
+#include "sdk/aap/AapControlCommand.h"
+#include "sdk/aap/att/AttPdu.h"
+#include "sdk/aap/att/AapHearingSettings.h"
+#include "device/capabilities/aap/AapAppleGatedCapability.h"
+#include "device/AapAttChannel.h"
+#include "Logger.h"
+
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+
+using namespace MagicPodsCore;
+
+static bool Near(float a, float b)
+{
+    return std::fabs(a - b) < 1e-5f;
+}
+
+static AapEarSettings SampleEar(float base)
+{
+    AapEarSettings ear{};
+    for (size_t i = 0; i < ear.eq.size(); ++i)
+        ear.eq[i] = base + i;
+    ear.amplification = 0.25f;
+    ear.tone = -0.5f;
+    ear.conversationBoost = true;
+    ear.ambientNoiseReduction = 0.75f;
+    return ear;
+}
+
+static void PutFloat(std::vector<unsigned char> &out, float value)
+{
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    for (int i = 0; i < 4; ++i)
+        out.push_back(static_cast<unsigned char>((bits >> (8 * i)) & 0xff));
+}
+
+static void PutEar(std::vector<unsigned char> &out, const AapEarSettings &ear)
+{
+    for (float gain : ear.eq)
+        PutFloat(out, gain);
+    PutFloat(out, ear.amplification);
+    PutFloat(out, ear.tone);
+    PutFloat(out, ear.conversationBoost ? 1.0f : 0.0f);
+    PutFloat(out, ear.ambientNoiseReduction);
+}
+
+// Attribute values as the AirPods send them.
+static std::vector<unsigned char> TransparencyBytes(bool enabled, const AapEarSettings &left, const AapEarSettings &right,
+                                                    std::optional<float> ownVoice = std::nullopt)
+{
+    std::vector<unsigned char> out{};
+    PutFloat(out, enabled ? 1.0f : 0.0f);
+    PutEar(out, left);
+    PutEar(out, right);
+    if (ownVoice.has_value())
+        PutFloat(out, ownVoice.value());
+    return out;
+}
+
+static std::vector<unsigned char> HearingAidBytes(const AapEarSettings &left, const AapEarSettings &right, float ownVoice)
+{
+    std::vector<unsigned char> out{0x02, 0x02, 0x60, 0x00};
+    PutEar(out, left);
+    PutEar(out, right);
+    PutFloat(out, ownVoice);
+    return out;
+}
+
+static float FloatAt(const std::vector<unsigned char> &data, size_t offset)
+{
+    uint32_t bits = static_cast<uint32_t>(data[offset]) | static_cast<uint32_t>(data[offset + 1]) << 8 |
+                    static_cast<uint32_t>(data[offset + 2]) << 16 | static_cast<uint32_t>(data[offset + 3]) << 24;
+    float value;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+// Whether a and b differ only in the 4-byte fields starting at the given offsets.
+static bool DiffersOnlyAt(const std::vector<unsigned char> &a, const std::vector<unsigned char> &b, std::vector<size_t> offsets)
+{
+    if (a.size() != b.size())
+        return false;
+    for (size_t i = 0; i < a.size(); ++i) {
+        bool inField = false;
+        for (size_t offset : offsets)
+            inField = inField || (i >= offset && i < offset + 4);
+        if (!inField && a[i] != b[i])
+            return false;
+    }
+    return true;
+}
+
+// A connection that records what is sent; the test delivers the answers.
+class FakeAttTransport : public AttTransport
+{
+private:
+    mutable std::mutex _mutex{};
+    std::vector<std::vector<unsigned char>> _sent{};
+    std::atomic<bool> _started{false};
+    Event<std::vector<unsigned char>> _received{};
+    Event<std::string> _lost{};
+
+public:
+    std::atomic<int> stops{0};
+
+    void Start() override { _started = true; }
+    void Stop() override
+    {
+        if (_started.exchange(false))
+            ++stops;
+    }
+    bool IsStarted() const override { return _started; }
+    void SendData(const std::vector<unsigned char> &data) override
+    {
+        std::lock_guard lock{_mutex};
+        _sent.push_back(data);
+    }
+    Event<std::vector<unsigned char>> &GetOnReceivedDataEvent() override { return _received; }
+    Event<std::string> &GetOnConnectionLostEvent() override { return _lost; }
+
+    std::vector<std::vector<unsigned char>> Sent() const
+    {
+        std::lock_guard lock{_mutex};
+        return _sent;
+    }
+    void Deliver(const std::vector<unsigned char> &data) { _received.FireEvent(data); }
+};
+
+template <typename Condition>
+static bool WaitFor(Condition condition)
+{
+    for (int i = 0; i < 200 && !condition(); ++i)
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    return condition();
+}
+
+struct ChannelProbe
+{
+    std::vector<AttValue> values{};
+    std::vector<uint16_t> errors{};
+    std::atomic<int> closedAfterTimeout{0};
+    std::mutex mutex{};
+
+    explicit ChannelProbe(AapAttChannel &channel)
+    {
+        channel.GetValueEvent().Subscribe([this](size_t, const AttValue &value) {
+            std::lock_guard lock{mutex};
+            values.push_back(value);
+        });
+        channel.GetErrorEvent().Subscribe([this](size_t, uint16_t handle) {
+            std::lock_guard lock{mutex};
+            errors.push_back(handle);
+        });
+        channel.GetClosedEvent().Subscribe([this](size_t, bool timedOut) {
+            if (timedOut)
+                ++closedAfterTimeout;
+        });
+    }
+};
+
+bool TestsAapAppleGated::TestModaliasApple()
+{
+    return HostDeviceId::IsAppleModalias("bluetooth:v004Cp0000d0000") &&
+           HostDeviceId::IsAppleModalias("BLUETOOTH:v004cp0000d0000");
+}
+
+bool TestsAapAppleGated::TestModaliasOther()
+{
+    // BlueZ's default Device ID is usb:v1D6Bp0246 (Linux Foundation).
+    return !HostDeviceId::IsAppleModalias("usb:v1D6Bp0246d0548") &&
+           !HostDeviceId::IsAppleModalias("usb:v004Cp0000d0000") &&
+           !HostDeviceId::IsAppleModalias("bluetooth:v004") &&
+           !HostDeviceId::IsAppleModalias("bluetooth:vXYZWp0000d0000") &&
+           !HostDeviceId::IsAppleModalias("");
+}
+
+bool TestsAapAppleGated::TestAttReadRequest()
+{
+    return Att::ReadRequest(0x2A) == std::vector<unsigned char>{0x0A, 0x2A, 0x00};
+}
+
+bool TestsAapAppleGated::TestAttWriteRequest()
+{
+    return Att::WriteRequest(0x1B, {0x01}) == std::vector<unsigned char>{0x12, 0x1B, 0x00, 0x01};
+}
+
+bool TestsAapAppleGated::TestAttEnableNotifications()
+{
+    return Att::EnableNotifications(0x18) == std::vector<unsigned char>{0x12, 0x19, 0x00, 0x01, 0x00};
+}
+
+bool TestsAapAppleGated::TestAttParseNotification()
+{
+    auto pdu = Att::Parse({0x1B, 0x2A, 0x00, 0x02, 0x02, 0x60, 0x00});
+    return pdu.has_value() && pdu->opcode == Att::Opcode::HandleValueNotification && pdu->handle == 0x2A &&
+           pdu->value == std::vector<unsigned char>{0x02, 0x02, 0x60, 0x00};
+}
+
+bool TestsAapAppleGated::TestAttParseErrorResponse()
+{
+    auto pdu = Att::Parse({0x01, 0x0A, 0x1B, 0x00, 0x02});
+    return pdu.has_value() && pdu->opcode == Att::Opcode::ErrorResponse && pdu->handle == 0x1B &&
+           !Att::Parse({0x01, 0x0A}).has_value() && !Att::Parse({}).has_value();
+}
+
+bool TestsAapAppleGated::TestAttRequestsFromPeer()
+{
+    return Att::IsRequestFromPeer(0x02) && Att::IsRequestFromPeer(0x0A) && Att::IsRequestFromPeer(0x12) &&
+           !Att::IsRequestFromPeer(0x52) && !Att::IsRequestFromPeer(0x1B) && !Att::IsRequestFromPeer(0x0B) &&
+           Att::ErrorResponse(0x08, 0x0001, Att::ErrorRequestNotSupported) == std::vector<unsigned char>{0x01, 0x08, 0x01, 0x00, 0x06} &&
+           Att::ExchangeMtuResponse(672) == std::vector<unsigned char>{0x03, 0xA0, 0x02};
+}
+
+bool TestsAapAppleGated::TestTransparencyParse()
+{
+    auto bytes = TransparencyBytes(true, SampleEar(1.0f), SampleEar(10.0f));
+    // enabled is the float 1.0: 00 00 80 3F
+    if (bytes.size() != 100 || !(bytes[0] == 0x00 && bytes[1] == 0x00 && bytes[2] == 0x80 && bytes[3] == 0x3F))
+        return false;
+    auto parsed = AapHearingSettings::ParseTransparency(bytes);
+    if (!parsed.has_value() || !parsed->enabled || parsed->ownVoiceAmplification.has_value())
+        return false;
+    auto withOwnVoice = AapHearingSettings::ParseTransparency(TransparencyBytes(false, SampleEar(1.0f), SampleEar(10.0f), 0.5f));
+    return Near(parsed->left.eq[7], 8.0f) && Near(parsed->right.eq[0], 10.0f) &&
+           Near(parsed->right.ambientNoiseReduction, 0.75f) && parsed->right.conversationBoost &&
+           withOwnVoice.has_value() && !withOwnVoice->enabled && Near(withOwnVoice->ownVoiceAmplification.value_or(0), 0.5f);
+}
+
+bool TestsAapAppleGated::TestHearingAidParse()
+{
+    auto parsed = AapHearingSettings::ParseHearingAid(HearingAidBytes(SampleEar(20.0f), SampleEar(30.0f), 0.5f));
+    return parsed.has_value() && parsed->header[2] == 0x60 && Near(parsed->left.eq[0], 20.0f) &&
+           Near(parsed->right.eq[7], 37.0f) && Near(parsed->ownVoiceAmplification, 0.5f);
+}
+
+bool TestsAapAppleGated::TestAttValueValidation()
+{
+    const auto transparency = TransparencyBytes(true, SampleEar(1.0f), SampleEar(2.0f), 0.5f);
+    const auto hearingAid = HearingAidBytes(SampleEar(1.0f), SampleEar(2.0f), 0.5f);
+    auto notFinite = hearingAid;
+    notFinite[40] = 0x00, notFinite[41] = 0x00, notFinite[42] = 0xC0, notFinite[43] = 0x7F; // NaN
+    return !AapHearingSettings::ParseTransparency(std::vector<unsigned char>(99)).has_value() &&
+           !AapHearingSettings::ParseTransparency(std::vector<unsigned char>(102)).has_value() &&
+           !AapHearingSettings::ParseHearingAid(std::vector<unsigned char>(103)).has_value() &&
+           // Both are 104 bytes; each is refused as the other attribute.
+           transparency.size() == 104 && hearingAid.size() == 104 &&
+           !AapHearingSettings::ParseHearingAid(transparency).has_value() &&
+           !AapHearingSettings::ParseTransparency(hearingAid).has_value() &&
+           !AapHearingSettings::ParseHearingAid(notFinite).has_value() &&
+           AapHearingSettings::ParseLoudSoundReduction({0x01}).value_or(false) &&
+           !AapHearingSettings::ParseLoudSoundReduction({0x00}).value_or(true) &&
+           !AapHearingSettings::ParseLoudSoundReduction({0x02}).has_value() &&
+           !AapHearingSettings::ParseLoudSoundReduction(transparency).has_value();
+}
+
+bool TestsAapAppleGated::TestAdjustmentsMapping()
+{
+    AapEarSettings left{}, right{};
+    left.amplification = 0.1f;
+    right.amplification = 0.5f;
+    left.tone = -0.2f;
+    left.ambientNoiseReduction = 0.3f;
+    left.conversationBoost = true;
+    auto adjustments = AapHearingSettings::ToAdjustments(left, right);
+    nlohmann::json body = nlohmann::json::object();
+    AapHearingSettings::AdjustmentsToJson(adjustments, body);
+    return adjustments.amplification == 30 && adjustments.balance == 40 && adjustments.tone == -20 &&
+           adjustments.ambientNoiseReduction == 30 && adjustments.conversationBoost &&
+           body["amplification"] == 30 && body["balance"] == 40 && body["conversationBoost"] == true;
+}
+
+// Ears set differently (as an iPhone may leave them), with values that do
+// not round to whole percent: one changed field leaves every other byte alone.
+bool TestsAapAppleGated::TestApplyChangesOnlyRequestedFields()
+{
+    AapEarSettings left = SampleEar(1.0f), right = SampleEar(2.0f);
+    left.amplification = 0.123f;
+    right.amplification = 0.377f;
+    left.tone = -0.31f;
+    right.tone = 0.42f;
+    left.conversationBoost = true;
+    right.conversationBoost = false;
+    left.ambientNoiseReduction = 0.15f;
+    right.ambientNoiseReduction = 0.65f;
+    auto original = HearingAidBytes(left, right, 0.25f);
+    // Bytes a newer firmware might add after the known layout.
+    original.push_back(0xAB);
+    original.push_back(0xCD);
+
+    auto tone = original;
+    if (!AapHearingSettings::ApplyToHearingAid(nlohmann::json{{"tone", 10}}, tone))
+        return false;
+    // Only the two tone floats and the header byte LibrePods sets.
+    const bool toneOnly = DiffersOnlyAt(original, tone, {0, 4 + 36, 52 + 36}) && tone[2] == 0x64 && tone[0] == 0x02 &&
+                          Near(FloatAt(tone, 4 + 36), 0.1f) && Near(FloatAt(tone, 52 + 36), 0.1f) &&
+                          tone.size() == 106 && tone[104] == 0xAB && tone[105] == 0xCD;
+
+    auto amplification = original;
+    if (!AapHearingSettings::ApplyToHearingAid(nlohmann::json{{"amplification", 50}}, amplification))
+        return false;
+    // The balance (right - left = 0.254) is kept, not rounded to 25 %.
+    const bool keepsBalance = DiffersOnlyAt(original, amplification, {0, 4 + 32, 52 + 32}) &&
+                              Near(FloatAt(amplification, 4 + 32), 0.5f - 0.127f) &&
+                              Near(FloatAt(amplification, 52 + 32), 0.5f + 0.127f);
+
+    auto transparency = TransparencyBytes(false, left, right, 0.25f);
+    auto selected = transparency;
+    if (!AapHearingSettings::ApplyToTransparency(nlohmann::json{{"selected", true}}, selected))
+        return false;
+    const bool selectedOnly = DiffersOnlyAt(transparency, selected, {0}) && Near(FloatAt(selected, 0), 1.0f);
+
+    return toneOnly && keepsBalance && selectedOnly;
+}
+
+bool TestsAapAppleGated::TestApplyRejects()
+{
+    const auto original = HearingAidBytes(SampleEar(1.0f), SampleEar(2.0f), 0.25f);
+    auto value = original;
+    const bool badType = !AapHearingSettings::ApplyToHearingAid(nlohmann::json{{"tone", 1}, {"conversationBoost", 1}}, value);
+    const bool outOfRange = !AapHearingSettings::ApplyToHearingAid(nlohmann::json{{"balance", 101}}, value);
+    auto transparency = TransparencyBytes(true, SampleEar(1.0f), SampleEar(2.0f));
+    const bool badSelected = !AapHearingSettings::ApplyToTransparency(nlohmann::json{{"selected", 1}}, transparency);
+    // Never writes a value it could not parse.
+    auto wrongAttribute = TransparencyBytes(true, SampleEar(1.0f), SampleEar(2.0f), 0.5f);
+    const bool refusesOther = !AapHearingSettings::ApplyToHearingAid(nlohmann::json{{"tone", 1}}, wrongAttribute);
+    return badType && outOfRange && badSelected && refusesOther && value == original;
+}
+
+bool TestsAapAppleGated::TestAdjustmentsFromJsonRejects()
+{
+    AapHearingAdjustments adjustments{};
+    adjustments.tone = 7;
+    bool ok = AapHearingSettings::AdjustmentsFromJson(nlohmann::json{{"amplification", 20}}, adjustments) &&
+              adjustments.amplification == 20 && adjustments.tone == 7;
+    bool outOfRange = !AapHearingSettings::AdjustmentsFromJson(nlohmann::json{{"ambientNoiseReduction", -1}, {"tone", 1}}, adjustments);
+    bool wrongType = !AapHearingSettings::AdjustmentsFromJson(nlohmann::json{{"conversationBoost", 1}}, adjustments);
+    bool notFloat = !AapHearingSettings::AdjustmentsFromJson(nlohmann::json{{"balance", 0.5}}, adjustments);
+    // A rejected request changes nothing.
+    return ok && outOfRange && wrongType && notFloat && adjustments.tone == 7 && adjustments.amplification == 20;
+}
