+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include "Event.h"
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace MagicPodsCore
+{
+    struct AttValue
+    {
+        uint16_t handle{};
+        std::vector<unsigned char> value{};
+    };
+
+    // What AapAttChannel needs from the L2CAP connection: Client in the
+    // daemon, a fake in the self-tests.
+    class AttTransport
+    {
+    public:
+        virtual ~AttTransport() = default;
+        // Connects (blocking) unless already connected.
+        virtual void Start() = 0;
+        virtual void Stop() = 0;
+        virtual bool IsStarted() const = 0;
+        virtual void SendData(const std::vector<unsigned char>& data) = 0;
+        virtual Event<std::vector<unsigned char>>& GetOnReceivedDataEvent() = 0;
+        // Fired when the connection dies on its own, never on Stop().
+        virtual Event<std::string>& GetOnConnectionLostEvent() = 0;
+    };
+
+    // A minimal ATT client on the BR/EDR L2CAP channel PSM 0x1F, for the
+    // AirPods attributes in AapAttHandle. ATT allows one outstanding request
+    // at a time, so requests are queued and sent one after another. Requests
+    // from the AirPods are answered (MTU exchange; anything else with
+    // "request not supported"), and indications are confirmed.
+    //
+    // A response is accepted only if it answers the request in flight: a
+    // Read Response for a Read Request, a Write Response for a Write Request,
+    // an Error Response naming the request's opcode and handle. Read
+    // Responses carry no handle, so after a request times out a late
+    // response could not be told apart from the answer to the next request.
+    // As the ATT specification requires after a transaction timeout, the
+    // channel is then closed instead: every pending request fails, and
+    // GetClosedEvent() tells the owner, which may connect again.
+    class AapAttChannel
+    {
+    public:
+        static constexpr std::chrono::milliseconds DefaultRequestTimeout{3000};
+
+    private:
+        static constexpr uint16_t LocalMtu = 672;
+
+        struct Request
+        {
+            std::vector<unsigned char> pdu{};
+            unsigned char opcode{};
+            uint16_t handle{};
+        };
+
+        std::unique_ptr<AttTransport> _transport{};
+        const std::chrono::milliseconds _requestTimeout;
+
+        // Serialises Start() and Stop(); never taken by the watchdog or by
+        // transport callbacks.
+        std::mutex _lifecycleMutex{};
+
+        // Request state, guarded by _mutex.
+        std::mutex _mutex{};
+        std::condition_variable _wake{};
+        std::deque<Request> _queue{};
+        bool _waiting{false};
+        Request _inFlight{};
+        std::chrono::steady_clock::time_point _sentAt{};
+        bool _watchdogRunning{false};
+
+        // Fails the request in flight when it times out, from its deadline
+        // rather than when the next request is queued. Joined only with
+        // _lifecycleMutex held.
+        std::thread _watchdog{};
+
+        size_t _receivedEventId{};
+        size_t _lostEventId{};
+
+        Event<AttValue> _onValue{};
+        Event<AttValue> _onWritten{};
+        Event<uint16_t> _onError{};
+        Event<bool> _onStarted{};
+        Event<bool> _onClosed{};
+
+        void OnData(const std::vector<unsigned char>& data);
+        void OnConnectionLost();
+        void WatchdogLoop();
+        // Expects _lifecycleMutex to be held.
+        void StopLocked();
+        // Expects _lifecycleMutex to be held.
+        void JoinWatchdog();
+        // Expects _mutex to be held.
+        void SendNextLocked();
+        // Expects _mutex to be held. Empties the queue and returns the handles
+        // of every request that will now never be answered.
+        std::vector<uint16_t> DropPendingLocked();
+        void FailRequests(const std::vector<uint16_t>& handles);
+        void Enqueue(Request request);
+
+    public:
+        explicit AapAttChannel(const std::string& address);
+        explicit AapAttChannel(std::unique_ptr<AttTransport> transport,
+                               std::chrono::milliseconds requestTimeout = DefaultRequestTimeout);
+        ~AapAttChannel();
+
+        AapAttChannel(const AapAttChannel&) = delete;
+        AapAttChannel& operator=(const AapAttChannel&) = delete;
+
+        // Connects the channel (blocking) unless it is already up. stillWanted,
+        // if given, is checked before and after connecting while Stop() is
+        // held off; when it returns false the channel ends up stopped.
+        bool Start(const std::function<bool()>& stillWanted = {});
+        void Stop();
+        bool IsStarted() const;
+
+        void Read(uint16_t handle);
+        void Write(uint16_t handle, const std::vector<unsigned char>& value);
+        void EnableNotifications(uint16_t handle);
+
+        // Read responses and notifications/indications, with their handle.
+        Event<AttValue>& GetValueEvent() { return _onValue; }
+        // Write responses, with the handle and the value that was written.
+        Event<AttValue>& GetWrittenEvent() { return _onWritten; }
+        // Error responses, timeouts and requests dropped when the channel
+        // closed on its own, with the handle of the request.
+        Event<uint16_t>& GetErrorEvent() { return _onError; }
+        // Fired after the channel connected; users queue their reads here.
+        Event<bool>& GetStartedEvent() { return _onStarted; }
+        // Fired when the channel closed on its own: true after a request
+        // timed out, false when the connection was lost. Never on Stop().
+        Event<bool>& GetClosedEvent() { return _onClosed; }
+    };
+}
