+bool TestsAapAppleGated::TestChannelMatchesResponses()
+{
+    auto owned = std::make_unique<FakeAttTransport>();
+    FakeAttTransport *transport = owned.get();
+    AapAttChannel channel{std::move(owned)};
+    ChannelProbe probe{channel};
+    if (!channel.Start())
+        return false;
+
+    channel.Read(0x2A);
+    channel.Read(0x18);
+    // Only the first request is sent until it is answered.
+    const bool oneAtATime = transport->Sent().size() == 1;
+    // A Write Response and an Error Response for another request do not
+    // answer the read in flight.
+    transport->Deliver({0x13});
+    transport->Deliver({0x01, 0x0A, 0x18, 0x00, 0x0A});
+    const bool ignored = probe.values.empty() && probe.errors.empty() && transport->Sent().size() == 1;
+    transport->Deliver({0x0B, 0x02, 0x02, 0x60, 0x00});
+    const bool answered = probe.values.size() == 1 && probe.values[0].handle == 0x2A && transport->Sent().size() == 2 &&
+                          transport->Sent()[1] == Att::ReadRequest(0x18);
+    // A matching Error Response answers the second read.
+    transport->Deliver({0x01, 0x0A, 0x18, 0x00, 0x0A});
+    const bool error = probe.errors == std::vector<uint16_t>{0x18};
+    channel.Stop();
+    return oneAtATime && ignored && answered && error;
+}
+
+bool TestsAapAppleGated::TestChannelTimeoutClosesChannel()
+{
+    auto owned = std::make_unique<FakeAttTransport>();
+    FakeAttTransport *transport = owned.get();
+    AapAttChannel channel{std::move(owned), std::chrono::milliseconds{50}};
+    ChannelProbe probe{channel};
+    if (!channel.Start())
+        return false;
+
+    channel.Read(0x18);
+    channel.Read(0x2A);
+    // Nothing else is queued: the deadline alone must fail the request,
+    // close the channel and fail the queued one.
+    const bool closed = WaitFor([&]() { return probe.closedAfterTimeout.load() == 1; });
+    const bool stopped = !channel.IsStarted() && transport->stops.load() == 1;
+    {
+        std::lock_guard lock{probe.mutex};
+        if (probe.errors != std::vector<uint16_t>{0x18, 0x2A})
+            return false;
+    }
+    // The late answer to the timed-out read is not taken for anything.
+    transport->Deliver({0x0B, 0x00, 0x00, 0x80, 0x3F});
+    const bool lateIgnored = probe.values.empty();
+
+    // Connecting again starts afresh.
+    const bool restarted = channel.Start() && channel.IsStarted();
+    channel.Read(0x1B);
+    transport->Deliver({0x0B, 0x01});
+    const bool works = probe.values.size() == 1 && probe.values[0].handle == 0x1B;
+    channel.Stop();
+    return closed && stopped && lateIgnored && restarted && works;
+}
+
+bool TestsAapAppleGated::TestChannelStartChecksWanted()
+{
+    auto owned = std::make_unique<FakeAttTransport>();
+    FakeAttTransport *transport = owned.get();
+    AapAttChannel channel{std::move(owned)};
+    int calls = 0;
+    // Wanted before connecting, no longer wanted once connected.
+    const bool refused = !channel.Start([&calls]() { return ++calls == 1; });
+    const bool stopped = !channel.IsStarted() && transport->stops.load() == 1 && calls == 2;
+    const bool notWanted = !channel.Start([]() { return false; }) && transport->stops.load() == 1;
+    return refused && stopped && notWanted;
+}
