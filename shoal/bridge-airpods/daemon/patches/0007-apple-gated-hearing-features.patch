+bool TestsAapAppleGated::TestSetHearingAid()
+{
+    return AapSetControl(AapControlId::HearingAid, 0x01, 0x01).Request() ==
+               std::vector<unsigned char>{0x04, 0x00, 0x04, 0x00, 0x09, 0x00, 0x2C, 0x01, 0x01, 0x00, 0x00} &&
+           AapSetControl(AapControlId::HearingAssist, 0x02).Request() ==
+               std::vector<unsigned char>{0x04, 0x00, 0x04, 0x00, 0x09, 0x00, 0x33, 0x02, 0x00, 0x00, 0x00};
+}
+
+bool TestsAapAppleGated::TestParseHearingAidCommand()
+{
+    auto command = AapControlCommand::Parse({0x04, 0x00, 0x04, 0x00, 0x09, 0x00, 0x2C, 0x01, 0x02, 0x00, 0x00});
+    return command.has_value() && command->identifier == 0x2C && command->data1 == 0x01 && command->data2 == 0x02 &&
+           !AapControlCommand::Parse({0x04, 0x00, 0x04, 0x00, 0x04, 0x00, 0x2C, 0x01, 0x02}).has_value();
+}
