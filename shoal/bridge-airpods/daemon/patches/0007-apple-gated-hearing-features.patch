@@ -0,0 +1,42 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include "sdk/aap/setters/AapRequest.h"
+
+#include <optional>
+#include <vector>
+
+namespace MagicPodsCore
+{
+    // AAP control commands (packet type 0x09) that the named MagicPodsCore
+    // setters do not cover, with identifiers from LibrePods
+    // (https://github.com/librepods-org/librepods, docs/control_commands.md):
+    //   04 00 04 00 09 00 <identifier> <data1> <data2> <data3> <data4>
+    enum class AapControlId : unsigned char
+    {
+        HearingAid = 0x2C,     // data1: enrolled, data2: enabled; 1 yes, 2 no
+        HearingAssist = 0x33,  // data1: 1 on, 2 off
+    };
+
+    struct AapControlCommand
+    {
+        unsigned char identifier{};
+        unsigned char data1{};
+        unsigned char data2{};
+
+        static std::optional<AapControlCommand> Parse(const std::vector<unsigned char> &data);
+    };
+
+    class AapSetControl : public AapRequest
+    {
+    private:
+        AapControlCommand _command{};
+
+    public:
+        AapSetControl(AapControlId identifier, unsigned char data1, unsigned char data2 = 0x00);
+        std::vector<unsigned char> Request() const override;
+    };
+}
diff --git a/src/sdk/aap/att/AapAttHandles.h b/src/sdk/aap/att/AapAttHandles.h
new file mode 100644
index 0000000..d7f7107
--- /dev/null
+++ b/src/sdk/aap/att/AapAttHandles.h
@@ -0,0 +1,27 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include <cstdint>
+
+namespace MagicPodsCore
+{
+    // Attribute value handles AirPods expose on the ATT channel (PSM 0x1F).
+    // AirPods answer on them only when the host's Device ID carries Apple's
+    // company identifier (0x004C). Handles and layouts as documented by
+    // LibrePods (https://github.com/librepods-org/librepods, ATTManager.kt,
+    // Transparency.kt, HearingAid.kt, linux/hearing-aid-adjustments.py).
+    enum class AapAttHandle : uint16_t
+    {
+        // Transparency mode customisation (headphone accommodations), 100 or
+        // 104 bytes of little-endian floats. Notifies.
+        Transparency = 0x18,
+        // Loud sound reduction, one byte: 1 on, 0 off. Does not notify.
+        LoudSoundReduction = 0x1B,
+        // Hearing aid adjustments and audiogram, 4-byte header + 100 bytes of
+        // little-endian floats. Notifies.
+        HearingAid = 0x2A,
+    };
+}
diff --git a/src/sdk/aap/att/AapHearingSettings.cpp b/src/sdk/aap/att/AapHearingSettings.cpp
new file mode 100644
index 0000000..e6b4a5b
--- /dev/null
+++ b/src/sdk/aap/att/AapHearingSettings.cpp
@@ -0,0 +1,234 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "AapHearingSettings.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+namespace MagicPodsCore
+{
+    static float GetFloat(const std::vector<unsigned char>& data, size_t offset)
+    {
+        // The attributes are little-endian IEEE 754, like every host this
+        // builds for; assemble the bytes explicitly anyway.
+        uint32_t bits = static_cast<uint32_t>(data[offset]) |
+                        static_cast<uint32_t>(data[offset + 1]) << 8 |
+                        static_cast<uint32_t>(data[offset + 2]) << 16 |
+                        static_cast<uint32_t>(data[offset + 3]) << 24;
+        float value;
+        std::memcpy(&value, &bits, sizeof(value));
+        return value;
+    }
+
+    static void PutFloatAt(std::vector<unsigned char>& data, size_t offset, float value)
+    {
+        uint32_t bits;
+        std::memcpy(&bits, &value, sizeof(bits));
+        for (size_t i = 0; i < 4; ++i)
+            data[offset + i] = static_cast<unsigned char>((bits >> (8 * i)) & 0xff);
+    }
+
+    // Offsets within an ear block.
+    static constexpr size_t AmplificationOffset = 32;
+    static constexpr size_t ToneOffset = 36;
+    static constexpr size_t ConversationBoostOffset = 40;
+    static constexpr size_t AmbientNoiseReductionOffset = 44;
+
+    static AapEarSettings ParseEar(const std::vector<unsigned char>& data, size_t offset)
+    {
+        AapEarSettings ear{};
+        for (size_t i = 0; i < ear.eq.size(); ++i)
+            ear.eq[i] = GetFloat(data, offset + i * 4);
+        ear.amplification = GetFloat(data, offset + AmplificationOffset);
+        ear.tone = GetFloat(data, offset + ToneOffset);
+        ear.conversationBoost = GetFloat(data, offset + ConversationBoostOffset) > 0.5f;
+        ear.ambientNoiseReduction = GetFloat(data, offset + AmbientNoiseReductionOffset);
+        return ear;
+    }
+
+    // Whether every float in [begin, end) is finite.
+    static bool FloatsFinite(const std::vector<unsigned char>& data, size_t begin, size_t end)
+    {
+        for (size_t offset = begin; offset + 4 <= end; offset += 4) {
+            if (!std::isfinite(GetFloat(data, offset)))
+                return false;
+        }
+        return true;
+    }
+
+    static bool IsTransparencyValue(const std::vector<unsigned char>& data)
+    {
+        if (data.size() != AapHearingSettings::BlocksEnd && data.size() < AapHearingSettings::BlocksEnd + 4)
+            return false;
+        const float enabled = GetFloat(data, 0);
+        return (enabled == 0.0f || enabled == 1.0f) && FloatsFinite(data, 0, AapHearingSettings::BlocksEnd + (data.size() > AapHearingSettings::BlocksEnd ? 4 : 0));
+    }
+
+    static bool IsHearingAidValue(const std::vector<unsigned char>& data)
+    {
+        if (data.size() < AapHearingSettings::BlocksEnd + 4)
+            return false;
+        return (data[2] == 0x60 || data[2] == 0x64) &&
+               FloatsFinite(data, AapHearingSettings::LeftEarOffset, AapHearingSettings::BlocksEnd + 4);
+    }
+
+    std::optional<AapHearingSettings::Transparency> AapHearingSettings::ParseTransparency(const std::vector<unsigned char>& data)
+    {
+        if (!IsTransparencyValue(data))
+            return std::nullopt;
+
+        Transparency value{};
+        value.enabled = GetFloat(data, 0) == 1.0f;
+        value.left = ParseEar(data, LeftEarOffset);
+        value.right = ParseEar(data, RightEarOffset);
+        if (data.size() >= BlocksEnd + 4)
+            value.ownVoiceAmplification = GetFloat(data, BlocksEnd);
+        return value;
+    }
+
+    std::optional<AapHearingSettings::HearingAid> AapHearingSettings::ParseHearingAid(const std::vector<unsigned char>& data)
+    {
+        if (!IsHearingAidValue(data))
+            return std::nullopt;
+
+        HearingAid value{};
+        std::copy_n(data.begin(), 4, value.header.begin());
+        value.left = ParseEar(data, LeftEarOffset);
+        value.right = ParseEar(data, RightEarOffset);
+        value.ownVoiceAmplification = GetFloat(data, BlocksEnd);
+        return value;
+    }
+
+    std::optional<bool> AapHearingSettings::ParseLoudSoundReduction(const std::vector<unsigned char>& data)
+    {
+        if (data.size() != 1 || data[0] > 0x01)
+            return std::nullopt;
+        return data[0] == 0x01;
+    }
+
+    bool AapHearingSettings::ApplyAdjustments(const nlohmann::json& json, std::vector<unsigned char>& value)
+    {
+        AapHearingAdjustments requested = ToAdjustments(ParseEar(value, LeftEarOffset), ParseEar(value, RightEarOffset));
+        if (!AdjustmentsFromJson(json, requested))
+            return false;
+
+        const size_t leftAmplification = LeftEarOffset + AmplificationOffset;
+        const size_t rightAmplification = RightEarOffset + AmplificationOffset;
+        const bool hasAmplification = json.contains("amplification");
+        const bool hasBalance = json.contains("balance");
+        if (hasAmplification || hasBalance) {
+            const float left = GetFloat(value, leftAmplification);
+            const float right = GetFloat(value, rightAmplification);
+            const float amplification = hasAmplification ? requested.amplification / 100.0f : (left + right) / 2.0f;
+            const float balance = hasBalance ? requested.balance / 100.0f : right - left;
+            PutFloatAt(value, leftAmplification, std::clamp(amplification - balance / 2.0f, -1.0f, 1.0f));
+            PutFloatAt(value, rightAmplification, std::clamp(amplification + balance / 2.0f, -1.0f, 1.0f));
+        }
+
+        auto putBoth = [&value](size_t offset, float number) {
+            PutFloatAt(value, LeftEarOffset + offset, number);
+            PutFloatAt(value, RightEarOffset + offset, number);
+        };
+        if (json.contains("tone"))
+            putBoth(ToneOffset, requested.tone / 100.0f);
+        if (json.contains("ambientNoiseReduction"))
+            putBoth(AmbientNoiseReductionOffset, requested.ambientNoiseReduction / 100.0f);
+        if (json.contains("conversationBoost"))
+            putBoth(ConversationBoostOffset, requested.conversationBoost ? 1.0f : 0.0f);
+        return true;
+    }
+
+    bool AapHearingSettings::ApplyToTransparency(const nlohmann::json& json, std::vector<unsigned char>& value)
+    {
+        if (!IsTransparencyValue(value))
+            return false;
+        if (json.contains("selected") && !json.at("selected").is_boolean())
+            return false;
+
+        auto next = value;
+        if (!ApplyAdjustments(json, next))
+            return false;
+        if (json.contains("selected"))
+            PutFloatAt(next, 0, json.at("selected").get<bool>() ? 1.0f : 0.0f);
+        value = std::move(next);
+        return true;
+    }
+
+    bool AapHearingSettings::ApplyToHearingAid(const nlohmann::json& json, std::vector<unsigned char>& value)
+    {
+        if (!IsHearingAidValue(value))
+            return false;
+
+        auto next = value;
+        if (!ApplyAdjustments(json, next))
+            return false;
+        // LibrePods (HearingAid.kt, hearing-aid-adjustments.py) always writes
+        // 0x64 here; the AirPods report 0x60.
+        next[2] = 0x64;
+        value = std::move(next);
+        return true;
+    }
+
+    static int ToPercent(float value, int low, int high)
+    {
+        if (!std::isfinite(value))
+            return 0;
+        return std::clamp(static_cast<int>(std::lround(value * 100.0f)), low, high);
+    }
+
+    AapHearingAdjustments AapHearingSettings::ToAdjustments(const AapEarSettings& left, const AapEarSettings& right)
+    {
+        AapHearingAdjustments adjustments{};
+        adjustments.amplification = ToPercent((left.amplification + right.amplification) / 2.0f, -100, 100);
+        adjustments.balance = ToPercent(right.amplification - left.amplification, -100, 100);
+        adjustments.tone = ToPercent(left.tone, -100, 100);
+        adjustments.ambientNoiseReduction = ToPercent(left.ambientNoiseReduction, 0, 100);
+        adjustments.conversationBoost = left.conversationBoost;
+        return adjustments;
+    }
+
+    void AapHearingSettings::AdjustmentsToJson(const AapHearingAdjustments& adjustments, nlohmann::json& body)
+    {
+        body["amplification"] = adjustments.amplification;
+        body["balance"] = adjustments.balance;
+        body["tone"] = adjustments.tone;
+        body["ambientNoiseReduction"] = adjustments.ambientNoiseReduction;
+        body["conversationBoost"] = adjustments.conversationBoost;
+    }
+
+    bool AapHearingSettings::AdjustmentsFromJson(const nlohmann::json& json, AapHearingAdjustments& adjustments)
+    {
+        AapHearingAdjustments result = adjustments;
+
+        auto readInt = [&json](const char* key, int low, int high, int& target) {
+            if (!json.contains(key))
+                return true;
+            const auto& value = json.at(key);
+            if (!value.is_number_integer())
+                return false;
+            const auto number = value.get<int64_t>();
+            if (number < low || number > high)
+                return false;
+            target = static_cast<int>(number);
+            return true;
+        };
+
+        if (!readInt("amplification", -100, 100, result.amplification) ||
+            !readInt("balance", -100, 100, result.balance) ||
+            !readInt("tone", -100, 100, result.tone) ||
+            !readInt("ambientNoiseReduction", 0, 100, result.ambientNoiseReduction))
+            return false;
+
+        if (json.contains("conversationBoost")) {
+            if (!json.at("conversationBoost").is_boolean())
+                return false;
+            result.conversationBoost = json.at("conversationBoost").get<bool>();
+        }
+
+        adjustments = result;
+        return true;
+    }
+}
diff --git a/src/sdk/aap/att/AapHearingSettings.h b/src/sdk/aap/att/AapHearingSettings.h
new file mode 100644
index 0000000..d31f57a
--- /dev/null
+++ b/src/sdk/aap/att/AapHearingSettings.h
@@ -0,0 +1,101 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include <array>
+#include <optional>
+#include <vector>
+#include <nlohmann/json.hpp>
+
+namespace MagicPodsCore
+{
+    // Per-ear block shared by the transparency and hearing aid attributes:
+    // eight gains (the audiogram bands 250 Hz to 8 kHz), then amplification,
+    // tone, conversation boost (1.0 on, 0.0 off) and ambient noise reduction.
+    struct AapEarSettings
+    {
+        std::array<float, 8> eq{};
+        float amplification{};
+        float tone{};
+        bool conversationBoost{};
+        float ambientNoiseReduction{};
+    };
+
+    // The adjustments the API exposes. Both ears get the same tone, boost and
+    // noise reduction; amplification and balance map to the two ears as
+    // left = amplification - balance / 2, right = amplification + balance / 2
+    // (LibrePods reads them back as the mean and the difference).
+    // Integer percentages, like the other MagicPodsCore capabilities.
+    struct AapHearingAdjustments
+    {
+        int amplification{};         // -100..100
+        int balance{};               // -100..100, positive favours the right ear
+        int tone{};                  // -100..100, positive is brighter
+        int ambientNoiseReduction{}; // 0..100
+        bool conversationBoost{};
+    };
+
+    class AapHearingSettings
+    {
+    public:
+        // Both attributes: a 4-byte field, the left ear block, the right ear
+        // block, then (optionally for transparency) own-voice amplification.
+        static constexpr size_t EarBlockSize = 48;
+        static constexpr size_t LeftEarOffset = 4;
+        static constexpr size_t RightEarOffset = LeftEarOffset + EarBlockSize;
+        static constexpr size_t BlocksEnd = RightEarOffset + EarBlockSize; // 100
+
+        // Transparency attribute (0x18): enabled flag (float 0.0 or 1.0),
+        // left block, right block, optional own-voice amplification. 100 or
+        // 104 bytes; longer values are accepted and their extra bytes kept.
+        struct Transparency
+        {
+            bool enabled{};
+            AapEarSettings left{};
+            AapEarSettings right{};
+            std::optional<float> ownVoiceAmplification{};
+        };
+
+        // Hearing aid attribute (0x2A): 4-byte header, left block, right
+        // block, own-voice amplification. 104 bytes or more. The AirPods
+        // report 0x60 in the third header byte; LibrePods writes 0x64.
+        struct HearingAid
+        {
+            std::array<unsigned char, 4> header{};
+            AapEarSettings left{};
+            AapEarSettings right{};
+            float ownVoiceAmplification{};
+        };
+
+        // Each returns nullopt unless data has the attribute's length and
+        // layout, with finite floats: a value of another attribute (as a
+        // response to a different request would be) is refused.
+        static std::optional<Transparency> ParseTransparency(const std::vector<unsigned char>& data);
+        static std::optional<HearingAid> ParseHearingAid(const std::vector<unsigned char>& data);
+        // Loud sound reduction (0x1B): exactly one byte, 0x00 or 0x01.
+        static std::optional<bool> ParseLoudSoundReduction(const std::vector<unsigned char>& data);
+
+        // The value to write for a SetCapabilities body: value as last read,
+        // with only the fields named in json rewritten in place. Every other
+        // byte (the audiogram, the other ear's settings, bytes a newer
+        // firmware adds) stays as it was. Amplification alone keeps the
+        // balance, balance alone keeps the amplification; tone, ambient noise
+        // reduction and conversation boost set both ears. Returns false and
+        // changes nothing if a present key has the wrong type or is out of
+        // range, or if value is not a valid attribute value.
+        static bool ApplyToTransparency(const nlohmann::json& json, std::vector<unsigned char>& value);
+        static bool ApplyToHearingAid(const nlohmann::json& json, std::vector<unsigned char>& value);
+
+        static AapHearingAdjustments ToAdjustments(const AapEarSettings& left, const AapEarSettings& right);
+        static void AdjustmentsToJson(const AapHearingAdjustments& adjustments, nlohmann::json& body);
+        // Reads any of the adjustment keys present in json into adjustments.
+        // Returns false (and changes nothing) if a present key has the wrong
+        // type or is out of range.
+        static bool AdjustmentsFromJson(const nlohmann::json& json, AapHearingAdjustments& adjustments);
+
+    private:
+        static bool ApplyAdjustments(const nlohmann::json& json, std::vector<unsigned char>& value);
+    };
+}
diff --git a/src/sdk/aap/att/AttPdu.cpp b/src/sdk/aap/att/AttPdu.cpp
new file mode 100644
index 0000000..7e0e8f2
--- /dev/null
+++ b/src/sdk/aap/att/AttPdu.cpp
@@ -0,0 +1,97 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "AttPdu.h"
+
+namespace MagicPodsCore::Att
+{
+    static void PutHandle(std::vector<unsigned char>& out, uint16_t handle)
+    {
+        out.push_back(static_cast<unsigned char>(handle & 0xff));
+        out.push_back(static_cast<unsigned char>(handle >> 8));
+    }
+
+    std::vector<unsigned char> ReadRequest(uint16_t handle)
+    {
+        std::vector<unsigned char> out{static_cast<unsigned char>(Opcode::ReadRequest)};
+        PutHandle(out, handle);
+        return out;
+    }
+
+    std::vector<unsigned char> WriteRequest(uint16_t handle, const std::vector<unsigned char>& value)
+    {
+        std::vector<unsigned char> out{static_cast<unsigned char>(Opcode::WriteRequest)};
+        PutHandle(out, handle);
+        out.insert(out.end(), value.begin(), value.end());
+        return out;
+    }
+
+    std::vector<unsigned char> EnableNotifications(uint16_t valueHandle)
+    {
+        return WriteRequest(static_cast<uint16_t>(valueHandle + 1), {0x01, 0x00});
+    }
+
+    std::vector<unsigned char> ExchangeMtuResponse(uint16_t mtu)
+    {
+        std::vector<unsigned char> out{static_cast<unsigned char>(Opcode::ExchangeMtuResponse)};
+        PutHandle(out, mtu);
+        return out;
+    }
+
+    std::vector<unsigned char> ErrorResponse(unsigned char requestOpcode, uint16_t handle, unsigned char errorCode)
+    {
+        std::vector<unsigned char> out{static_cast<unsigned char>(Opcode::ErrorResponse), requestOpcode};
+        PutHandle(out, handle);
+        out.push_back(errorCode);
+        return out;
+    }
+
+    std::vector<unsigned char> HandleValueConfirmation()
+    {
+        return {static_cast<unsigned char>(Opcode::HandleValueConfirmation)};
+    }
+
+    std::optional<Pdu> Parse(const std::vector<unsigned char>& data)
+    {
+        if (data.empty())
+            return std::nullopt;
+
+        Pdu pdu{};
+        pdu.opcode = static_cast<Opcode>(data[0]);
+        switch (pdu.opcode) {
+            case Opcode::HandleValueNotification:
+            case Opcode::HandleValueIndication:
+                if (data.size() < 3)
+                    return std::nullopt;
+                pdu.handle = static_cast<uint16_t>(data[1] | (data[2] << 8));
+                pdu.value.assign(data.begin() + 3, data.end());
+                return pdu;
+            case Opcode::ErrorResponse:
+                // request opcode, handle, error code
+                if (data.size() < 5)
+                    return std::nullopt;
+                pdu.handle = static_cast<uint16_t>(data[2] | (data[3] << 8));
+                pdu.value.assign(data.begin() + 1, data.end());
+                return pdu;
+            default:
+                pdu.value.assign(data.begin() + 1, data.end());
+                return pdu;
+        }
+    }
+
+    bool IsRequestFromPeer(unsigned char opcode)
+    {
+        // The ATT request opcodes: exchange MTU, find information, find by
+        // type value, read by type, read, read blob, read multiple, read by
+        // group type, write, prepare write, execute write, read multiple
+        // variable. Commands, responses and confirmations need no answer.
+        switch (opcode) {
+            case 0x02: case 0x04: case 0x06: case 0x08: case 0x0A: case 0x0C:
+            case 0x0E: case 0x10: case 0x12: case 0x16: case 0x18: case 0x20:
+                return true;
+            default:
+                return false;
+        }
+    }
+}
diff --git a/src/sdk/aap/att/AttPdu.h b/src/sdk/aap/att/AttPdu.h
new file mode 100644
index 0000000..78242cc
--- /dev/null
+++ b/src/sdk/aap/att/AttPdu.h
@@ -0,0 +1,62 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+namespace MagicPodsCore
+{
+    // Attribute Protocol (Bluetooth Core, Vol 3, Part F) over the BR/EDR
+    // L2CAP channel with PSM 0x001F. AirPods expose a few settings as plain
+    // attributes on it; see AapAttHandles.
+    namespace Att
+    {
+        constexpr unsigned short PSM = 0x001F;
+
+        enum class Opcode : unsigned char
+        {
+            ErrorResponse = 0x01,
+            ExchangeMtuRequest = 0x02,
+            ExchangeMtuResponse = 0x03,
+            ReadRequest = 0x0A,
+            ReadResponse = 0x0B,
+            WriteRequest = 0x12,
+            WriteResponse = 0x13,
+            HandleValueNotification = 0x1B,
+            HandleValueIndication = 0x1D,
+            HandleValueConfirmation = 0x1E,
+        };
+
+        // Error code "Request Not Supported".
+        constexpr unsigned char ErrorRequestNotSupported = 0x06;
+
+        struct Pdu
+        {
+            Opcode opcode{};
+            // Handle for notifications, indications and error responses; 0 otherwise.
+            uint16_t handle{};
+            // Attribute value (read response, notification, indication), or
+            // the remaining parameters for other PDUs.
+            std::vector<unsigned char> value{};
+        };
+
+        std::vector<unsigned char> ReadRequest(uint16_t handle);
+        std::vector<unsigned char> WriteRequest(uint16_t handle, const std::vector<unsigned char>& value);
+        // Writes 0x0001 to the Client Characteristic Configuration descriptor,
+        // which AirPods place at value handle + 1.
+        std::vector<unsigned char> EnableNotifications(uint16_t valueHandle);
+        std::vector<unsigned char> ExchangeMtuResponse(uint16_t mtu);
+        std::vector<unsigned char> ErrorResponse(unsigned char requestOpcode, uint16_t handle, unsigned char errorCode);
+        std::vector<unsigned char> HandleValueConfirmation();
+
+        std::optional<Pdu> Parse(const std::vector<unsigned char>& data);
+
+        // True for a request opcode. A request from the peer must be answered,
+        // or ATT stops the channel after its 30 s transaction timeout.
+        bool IsRequestFromPeer(unsigned char opcode);
+    }
+}
