+        // Powered changes of every adapter, not only the selected one, so that
+        // an unpowered selection is replaced when another adapter is powered on.
+        _rootProxy->getConnection().addMatch(
+            "type='signal',sender='org.bluez',interface='org.freedesktop.DBus.Properties',"
