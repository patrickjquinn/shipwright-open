 namespace MagicPodsCore {
 
     // Keeps track of BlueZ adapters and sends requests to the selected adapter.
-    // The first available adapter stays selected until BlueZ removes it.
+    //
+    // Selection policy:
+    // - If MAGICPODS_ADAPTER is set (e.g. "hci1" or "/org/bluez/hci1"), only
+    //   that adapter is ever selected; until it appears, there is no adapter.
+    // - Otherwise a powered adapter is preferred over an unpowered one, and
+    //   the lowest object path wins among equals.
+    // - A selected adapter stays selected until BlueZ removes it, except that
+    //   an unpowered selection is replaced when a powered adapter appears or
+    //   another known adapter is powered on.
     class DBusBtAdapter {
     private:
         // D-Bus signal callbacks and application requests run on different threads.
         mutable std::mutex _mutex{};
+        // Serialises publishing the selected adapter's state, so that values
+        // read from an adapter cannot be published after it was deselected or
+        // removed. Never held while a proxy is destroyed.
+        std::mutex _publishMutex{};
         ObservableVariable<bool> _isPowered{false};
-        std::set<sdbus::ObjectPath> _availableAdapterPaths{};
+        // Available adapters and their last known Powered state, kept current
+        // through PropertiesChanged (UpdateAdapterPowered for the others).
+        std::map<sdbus::ObjectPath, bool> _availableAdapters{};
         sdbus::ObjectPath _currentAdapterPath{};
+        // Adapter requested through MAGICPODS_ADAPTER, empty if not set.
+        sdbus::ObjectPath _forcedAdapterPath{};
 
         // Shared ownership lets an in-progress request finish while BlueZ
         // replaces the adapter.
         std::shared_ptr<sdbus::IProxy> _currentAdapterProxy{};
 
     public:
-        DBusBtAdapter() = default;
+        DBusBtAdapter();
         ~DBusBtAdapter();
 
         DBusBtAdapter(const DBusBtAdapter&) = delete;
@@ -39,8 +55,15 @@ namespace MagicPodsCore {
         DBusBtAdapter& operator=(const DBusBtAdapter&) = delete;
         DBusBtAdapter& operator=(DBusBtAdapter&&) noexcept = delete;
 
-        void AddAdapter(const sdbus::ObjectPath& objectPath);
+        // powered: the adapter's Powered property as reported with the
+        // object (GetManagedObjects or InterfacesAdded), false if unknown.
+        void AddAdapter(const sdbus::ObjectPath& objectPath, bool powered);
         void RemoveAdapter(const sdbus::ObjectPath& objectPath);
+        // A known adapter's Powered property changed (PropertiesChanged on
+        // any adapter, see DBusService).
+        void UpdateAdapterPowered(const sdbus::ObjectPath& objectPath, bool powered);
+
+        bool HasAdapter() const;
 
         ObservableVariable<bool>& IsPowered() {
             return _isPowered;
@@ -62,6 +85,14 @@ namespace MagicPodsCore {
         std::shared_ptr<sdbus::IProxy> GetCurrentAdapterProxy() const;
         bool IsCurrentAdapter(const sdbus::ObjectPath& objectPath) const;
         void SelectAdapter(const sdbus::ObjectPath& objectPath);
+        void DeselectCurrentAdapter();
+        bool IsSelectable(const sdbus::ObjectPath& objectPath) const;
+        sdbus::ObjectPath PickAdapterLocked() const;
+        // Whether a powered candidate should replace an unpowered selection;
+        // if so, currentPath receives the selection. Expects _mutex held.
+        bool ShouldReplaceSelectionLocked(const sdbus::ObjectPath& candidate, bool powered,
+                                          sdbus::ObjectPath& currentPath) const;
