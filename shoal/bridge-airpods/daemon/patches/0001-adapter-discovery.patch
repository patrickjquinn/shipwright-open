+    sdbus::ObjectPath DBusBtAdapter::PickAdapterLocked() const {
+        sdbus::ObjectPath fallback{};
+        for (const auto& [path, powered] : _availableAdapters) {
+            if (!IsSelectable(path)) {
+                continue;
+            }
+            if (powered) {
