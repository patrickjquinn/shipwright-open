+    void DBusService::HandleAdapterPropertiesChanged(sdbus::Message& message) {
+        try {
+            std::string interfaceName{};
+            std::map<std::string, sdbus::Variant> values{};
+            message >> interfaceName >> values;
+            const auto powered = values.find("Powered");
+            if (interfaceName == BLUEZ_ADAPTER_INTERFACE && powered != values.end()) {
+                _bluetoothAdapter.UpdateAdapterPowered(sdbus::ObjectPath{message.getPath()}, powered->second.get<bool>());
+            }
+        }
+        catch (const std::exception& error) {
+            Logger::Error("Failed to handle adapter PropertiesChanged: %s", error.what());
+        }
+    }
