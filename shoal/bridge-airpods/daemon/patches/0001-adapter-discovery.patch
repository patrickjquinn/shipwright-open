+    bool DBusBtAdapter::ShouldReplaceSelectionLocked(const sdbus::ObjectPath& candidate, bool powered,
+                                                     sdbus::ObjectPath& currentPath) const {
+        // Prefer a powered adapter over an unpowered selection, e.g. when hci0
+        // exists but is down and hci1 is the working one.
+        if (!powered || _currentAdapterPath.empty() || _currentAdapterPath == candidate || !IsSelectable(candidate)) {
+            return false;
+        }
+        const auto current = _availableAdapters.find(_currentAdapterPath);
+        if (current == _availableAdapters.end() || current->second) {
+            return false;
+        }
+        currentPath = _currentAdapterPath;
+        return true;
+    }
+
+    void DBusBtAdapter::SwitchAdapter(const sdbus::ObjectPath& from, const sdbus::ObjectPath& to) {
+        Logger::Info("Switching from unpowered Bluetooth adapter %s to powered adapter %s", from.c_str(), to.c_str());
+        DeselectCurrentAdapter();
+        SelectAdapter(to);
+    }
+
+    void DBusBtAdapter::UpdateAdapterPowered(const sdbus::ObjectPath& objectPath, bool powered) {
+        sdbus::ObjectPath currentPath{};
+        {
+            std::lock_guard lock{_mutex};
+            const auto known = _availableAdapters.find(objectPath);
+            // The selected adapter is followed through its own proxy.
+            if (known == _availableAdapters.end() || objectPath == _currentAdapterPath) {
+                return;
+            }
+            known->second = powered;
+            if (!ShouldReplaceSelectionLocked(objectPath, powered, currentPath)) {
+                return;
+            }
+        }
+        SwitchAdapter(currentPath, objectPath);
+    }
+
+    void DBusBtAdapter::DeselectCurrentAdapter() {
+        std::shared_ptr<sdbus::IProxy> oldProxy;
+        {
+            std::lock_guard lock{_mutex};
+            if (_currentAdapterPath.empty()) {
+                return;
+            }
+            _currentAdapterPath.clear();
+            oldProxy = std::move(_currentAdapterProxy);
+        }
+
+        // Wait until callbacks from the old adapter have finished before
+        // publishing its final powered-off state.
+        oldProxy.reset();
+        std::lock_guard publishLock{_publishMutex};
+        _isPowered.SetValue(false);
+    }
+
