diff --git a/src/device/capabilities/aap/AapMultiDeviceCapability.cpp b/src/device/capabilities/aap/AapMultiDeviceCapability.cpp
new file mode 100644
index 0000000..d93a406
--- /dev/null
+++ b/src/device/capabilities/aap/AapMultiDeviceCapability.cpp
@@ -0,0 +1,57 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "AapMultiDeviceCapability.h"
+#include "sdk/aap/AapControlCommand.h"
+
+namespace MagicPodsCore
+{
+    AapMultiDeviceCapability::AapMultiDeviceCapability(AapDevice &device)
+        : AapAppleGatedCapability("multiDevice", false, device)
+    {
+    }
+
+    void AapMultiDeviceCapability::ResetData()
+    {
+        hosts.clear();
+        ownsConnection = false;
+    }
+
+    nlohmann::json AapMultiDeviceCapability::CreateAvailableJsonBody()
+    {
+        return nlohmann::json{{"hosts", hosts}, {"ownsConnection", ownsConnection}};
+    }
+
+    void AapMultiDeviceCapability::OnReceivedData(const std::vector<unsigned char> &data)
+    {
+        if (auto command = AapControlCommand::Parse(data);
+            command.has_value() && command->identifier == static_cast<unsigned char>(AapControlId::OwnsConnection)) {
+            const bool owns = command->data1 == 0x01;
+            if (owns != ownsConnection) {
+                ownsConnection = owns;
+                Logger::Info("%s: owns connection %d", name.c_str(), ownsConnection);
+                DataUpdated();
+            }
+            return;
+        }
+
+        if (auto connected = AapConnectedHosts::Parse(data); connected.has_value()) {
+            if (connected->addresses != hosts) {
+                hosts = connected->addresses;
+                Logger::Info("%s: %zu connected hosts", name.c_str(), hosts.size());
+                DataUpdated();
+            }
+        }
+    }
+
+    void AapMultiDeviceCapability::SetAvailableFromJson(const nlohmann::json &body)
+    {
+        if (!body.contains("takeOver") || !body["takeOver"].is_boolean()) {
+            Logger::Error("Error: %s::SetFromJson expects takeOver: true", name.c_str());
+            return;
+        }
+        if (body["takeOver"].get<bool>())
+            SendData(AapSetControl(AapControlId::OwnsConnection, 0x01));
+    }
+}
diff --git a/src/device/capabilities/aap/AapMultiDeviceCapability.h b/src/device/capabilities/aap/AapMultiDeviceCapability.h
new file mode 100644
index 0000000..1358b93
--- /dev/null
+++ b/src/device/capabilities/aap/AapMultiDeviceCapability.h
@@ -0,0 +1,37 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include "AapAppleGatedCapability.h"
+
+#include <string>
+#include <vector>
+
+namespace MagicPodsCore
+{
+    // "multiDevice": AirPods stay connected to two hosts at once (audio and
+    // control) only if both present Apple's Device ID.
+    //   {"hosts": [addresses], "ownsConnection": bool}
+    // Setting {"takeOver": true} asks the AirPods to route audio here
+    // (control command 0x06, "owns connection"). Needs Apple's Device ID.
+    class AapMultiDeviceCapability : public AapAppleGatedCapability
+    {
+    private:
+        std::vector<std::string> hosts{};
+        bool ownsConnection{};
+
+    protected:
+        nlohmann::json CreateAvailableJsonBody() override;
+        void SetAvailableFromJson(const nlohmann::json &body) override;
+        void OnReceivedData(const std::vector<unsigned char> &data) override;
+        // Shown as soon as the AirPods are connected: they report hosts and
+        // ownership only when something changes.
+        bool HasData() const override { return true; }
+        void ResetData() override;
+
+    public:
+        explicit AapMultiDeviceCapability(AapDevice &device);
+    };
+}
