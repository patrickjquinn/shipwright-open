 #include <vector>
 
 namespace MagicPodsCore
@@ -17,6 +18,7 @@ namespace MagicPodsCore
     //   04 00 04 00 09 00 <identifier> <data1> <data2> <data3> <data4>
     enum class AapControlId : unsigned char
     {
+        OwnsConnection = 0x06, // data1: 1 owns, 0 does not
         HearingAid = 0x2C,     // data1: enrolled, data2: enabled; 1 yes, 2 no
         HearingAssist = 0x33,  // data1: 1 on, 2 off
     };
@@ -39,4 +41,14 @@ namespace MagicPodsCore
         AapSetControl(AapControlId identifier, unsigned char data1, unsigned char data2 = 0x00);
         std::vector<unsigned char> Request() const override;
     };
+
+    // Packet type 0x2E: the hosts the AirPods are connected to.
+    //   04 00 04 00 2E 00 xx xx <count> then per host 6 address bytes and 2
+    //   bytes of unknown meaning.
+    struct AapConnectedHosts
+    {
+        std::vector<std::string> addresses{};
+
+        static std::optional<AapConnectedHosts> Parse(const std::vector<unsigned char> &data);
+    };
 }
