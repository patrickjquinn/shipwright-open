index 7d2e4bc..e8ad116 100644
--- a/src/sdk/aap/AapControlCommand.cpp
+++ b/src/sdk/aap/AapControlCommand.cpp
@@ -5,6 +5,8 @@
 #include "AapControlCommand.h"
 #include "sdk/aap/enums/AapCmd.h"
 
+#include <cstdio>
+
 namespace MagicPodsCore
 {
     std::optional<AapControlCommand> AapControlCommand::Parse(const std::vector<unsigned char> &data)
@@ -24,4 +26,21 @@ namespace MagicPodsCore
         return std::vector<unsigned char>{0x04, 0x00, 0x04, 0x00, static_cast<unsigned char>(AapCmd::Settings), 0x00,
                                           _command.identifier, _command.data1, _command.data2, 0x00, 0x00};
     }
+
+    std::optional<AapConnectedHosts> AapConnectedHosts::Parse(const std::vector<unsigned char> &data)
+    {
+        if (data.size() < 9 || data[4] != 0x2E)
+            return std::nullopt;
+
+        AapConnectedHosts hosts{};
+        const size_t count = data[8];
+        size_t offset = 9;
+        for (size_t i = 0; i < count && offset + 8 <= data.size(); ++i, offset += 8) {
+            char address[18];
+            std::snprintf(address, sizeof(address), "%02X:%02X:%02X:%02X:%02X:%02X",
+                          data[offset], data[offset + 1], data[offset + 2], data[offset + 3], data[offset + 4], data[offset + 5]);
+            hosts.addresses.emplace_back(address);
+        }
+        return hosts;
+    }
 }
