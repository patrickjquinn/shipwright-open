+bool TestsAapAppleGated::TestSetOwnsConnection()
+{
+    return AapSetControl(AapControlId::OwnsConnection, 0x01).Request() ==
+           std::vector<unsigned char>{0x04, 0x00, 0x04, 0x00, 0x09, 0x00, 0x06, 0x01, 0x00, 0x00, 0x00};
+}
+
+bool TestsAapAppleGated::TestParseConnectedHosts()
+{
+    std::vector<unsigned char> data{0x04, 0x00, 0x04, 0x00, 0x2E, 0x00, 0x00, 0x00, 0x02,
+                                    0xAA, 0xBB, 0xCC, 0x00, 0x11, 0x22, 0x01, 0x00,
+                                    0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x02, 0x00};
+    auto hosts = AapConnectedHosts::Parse(data);
+    // A truncated list returns what is complete.
+    data.resize(data.size() - 1);
+    auto truncated = AapConnectedHosts::Parse(data);
+    return hosts.has_value() && hosts->addresses.size() == 2 && hosts->addresses[0] == "AA:BB:CC:00:11:22" &&
+           hosts->addresses[1] == "10:20:30:40:50:60" && truncated.has_value() && truncated->addresses.size() == 1;
+}
