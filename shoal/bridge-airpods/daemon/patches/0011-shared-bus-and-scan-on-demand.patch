diff --git a/src/dbus/SystemBus.h b/src/dbus/SystemBus.h
new file mode 100644
index 0000000..7c9eccf
--- /dev/null
+++ b/src/dbus/SystemBus.h
@@ -0,0 +1,29 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include <sdbus-c++/sdbus-c++.h>
+
+#include <memory>
+
+namespace MagicPodsCore {
+
+    // The one system bus connection every BlueZ proxy shares, with its own
+    // event loop thread. sdbus::createProxy(destination, path) gives each
+    // proxy a connection and a thread of its own, and there is a proxy per
+    // Bluetooth device BlueZ knows: on a phone in a busy place the daemon
+    // held hundreds of system bus connections, up to the per-user limit
+    // (256), after which nothing else of the user's could reach the system
+    // bus.
+    inline sdbus::IConnection& SystemBus() {
+        static const std::unique_ptr<sdbus::IConnection> connection = [] {
+            auto bus = sdbus::createSystemBusConnection();
+            bus->enterEventLoopAsync();
+            return bus;
+        }();
+        return *connection;
+    }
+
+}
