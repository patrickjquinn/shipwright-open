@@ -0,0 +1,55 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#pragma once
+
+#include "Event.h"
+
+#include <mutex>
+#include <string>
+
+namespace MagicPodsCore {
+
+    // The Device ID (DID profile) the host's Bluetooth adapter presents to
+    // peers, as BlueZ reports it in org.bluez.Adapter1.Modalias. BlueZ builds
+    // that value from "DeviceID" in main.conf, e.g. DeviceID =
+    // bluetooth:004C:0000:0000 gives "bluetooth:v004Cp0000d0000".
+    //
+    // AirPods enable some features (hearing aid, customised transparency, loud
+    // sound reduction, a second connected host) only for hosts whose Device ID
+    // carries Apple's Bluetooth SIG company identifier, 0x004C.
+    //
+    // MAGICPODS_HOST_DEVICE_ID overrides the detection with a modalias string
+    // (for tests, or when the adapter does not report one).
+    class HostDeviceId {
+    private:
+        mutable std::mutex _mutex{};
+        std::string _modalias{};
+        std::string _override{};
+        Event<bool> _changedEvent{};
+
+        HostDeviceId();
+
+    public:
+        static constexpr unsigned short APPLE_COMPANY_ID = 0x004C;
+
+        static HostDeviceId& Instance();
+
+        // Updates the adapter's modalias; fires the changed event if the
+        // Apple/non-Apple result changes. An empty string means no adapter.
+        void SetModalias(const std::string& modalias);
+
+        std::string GetModalias() const;
+        bool IsApple() const;
+
+        // Fired with IsApple() after it changes.
+        Event<bool>& GetChangedEvent() {
+            return _changedEvent;
+        }
+
+        // True if modalias is "bluetooth:v004C...", i.e. DID source 1
+        // (Bluetooth SIG) with Apple's company identifier. Case-insensitive.
+        static bool IsAppleModalias(const std::string& modalias);
+    };
+}
