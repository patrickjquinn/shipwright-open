@@ -0,0 +1,66 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// Copyright: 2026 Patrick Quinn
+// License: GPL-3.0
+
+#include "HostDeviceId.h"
+#include "Logger.h"
+
+#include <cctype>
+#include <cstdlib>
+
+namespace MagicPodsCore {
+
+    HostDeviceId::HostDeviceId() {
+        if (const char* value = std::getenv("MAGICPODS_HOST_DEVICE_ID"); value != nullptr && *value != '\0') {
+            _override = value;
+            Logger::Info("Host Device ID overridden by MAGICPODS_HOST_DEVICE_ID: %s (%s)",
+                         _override.c_str(), IsAppleModalias(_override) ? "Apple" : "not Apple");
+        }
+    }
+
+    HostDeviceId& HostDeviceId::Instance() {
+        static HostDeviceId instance{};
+        return instance;
+    }
+
+    bool HostDeviceId::IsAppleModalias(const std::string& modalias) {
+        // bluetooth:vXXXXpXXXXdXXXX
+        static const std::string prefix = "bluetooth:v";
+        if (modalias.size() < prefix.size() + 4)
+            return false;
+        for (size_t i = 0; i < prefix.size(); ++i) {
+            if (std::tolower(static_cast<unsigned char>(modalias[i])) != prefix[i])
+                return false;
+        }
+        const std::string vendor = modalias.substr(prefix.size(), 4);
+        for (char c : vendor) {
+            if (!std::isxdigit(static_cast<unsigned char>(c)))
+                return false;
+        }
+        return std::stoul(vendor, nullptr, 16) == APPLE_COMPANY_ID;
+    }
+
+    void HostDeviceId::SetModalias(const std::string& modalias) {
+        bool before;
+        bool after;
+        {
+            std::lock_guard lock{_mutex};
+            before = IsAppleModalias(_override.empty() ? _modalias : _override);
+            _modalias = modalias;
+            after = IsAppleModalias(_override.empty() ? _modalias : _override);
+        }
+        Logger::Info("Host Device ID: %s (%s)", modalias.empty() ? "none" : modalias.c_str(),
+                     after ? "Apple" : "not Apple");
+        if (before != after)
+            _changedEvent.FireEvent(after);
+    }
+
+    std::string HostDeviceId::GetModalias() const {
+        std::lock_guard lock{_mutex};
+        return _override.empty() ? _modalias : _override;
+    }
+
+    bool HostDeviceId::IsApple() const {
+        return IsAppleModalias(GetModalias());
+    }
+}
