#
# Runs the Reef background check every 4 hours (the setting picks every
# few hours, weekly or never from there, src/check.rs); Persistent catches
# up after the phone was off. The package's %post starts it in the running
# session; the wants symlink starts it at later logins.
[Unit]
Description=Reef update check

[Timer]
OnBootSec=10min
OnCalendar=00/4:00
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
