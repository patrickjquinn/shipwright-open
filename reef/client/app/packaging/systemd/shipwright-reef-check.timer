#
# Runs the Reef background check every 4 hours (the setting picks every
# few hours, weekly or never from there, src/check.rs); Persistent catches
# up after the phone was off. Enabled (systemctl --user enable --now) only
# when the person turns background checks on in Reef; "Never" disables it.
[Unit]
Description=Reef update check

[Timer]
OnBootSec=10min
OnCalendar=00/4:00
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
