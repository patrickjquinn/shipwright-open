#!/bin/sh
# SPDX-FileCopyrightText: 2026 Patrick Quinn
# SPDX-License-Identifier: GPL-3.0-or-later
#
# shipwright-reef-installer: finishes installing Reef after the installer
# RPM's own transaction has ended.
#
# Follows sailfishos-chum-gui-installer's bin/sailfishos-chum-gui-installer
# (github.com/sailfishos-chum/sailfishos-chum-gui-installer, commit a757ca4):
#   * started fully detached (setsid --fork) as the last act of %posttrans,
#     because PackageKit cannot start a transaction while the RPM transaction
#     that installed us is still open;
#   * waits for the %posttrans shell (whose PID it is given) to exit;
#   * refreshes only our repository with `pkcon repo-set-data <alias>
#     refresh-now true`, retrying with longer waits. Unlike the Chum
#     installer it never kills pkcon or restarts PackageKit: those are
#     everyone's (an OS update or a Jolla Store install may be running), and
#     killing them aborted other people's work (sweep, 12 October 2026);
#   * finally runs `pkcon -y install <client>` detached again, because
#     installing the client obsoletes this package and deletes this file.
# Additions for Reef: `rpm --import` of the signing key happens here, after
# the RPM transaction (rpm cannot re-enter its database from a scriptlet),
# and before the refresh so repository metadata and packages verify.
#
# usage: shipwright-reef-installer <posttrans PID> <logfile>
# stdout and stderr are already redirected to the log by %posttrans.

# -u only, on purpose: the refresh retry loop expects pkcon to fail and
# time out, and every step's status is checked and logged explicitly.
set -u

called=shipwright-reef-installer
REEF_CONF=${REEF_CONF:-/usr/share/shipwright-reef-installer/repo.conf}
REPO_TOOL=${REPO_TOOL:-/usr/bin/shipwright-reef-repo}

# --notify SUMMARY BODY: only the notification (the detached install's
# failure, step 5).
if [ "${1:-}" = --notify ] && [ $# = 3 ]; then
  notify_mode=1
elif [ $# != 2 ]; then
  echo "[$called] expected 2 arguments (posttrans PID, logfile), got $#" >&2
  exit 67
fi
if [ "${notify_mode:-0}" = 1 ]; then
  ppid_wait=0
else
  ppid_wait=$1
fi
case "$ppid_wait" in
  '' | *[!0-9]*)
    echo "[$called] first argument $ppid_wait is not a PID" >&2
    exit 68
    ;;
esac
logfile=$2
# shellcheck source-path=SCRIPTDIR source=../repo.conf
. "$REEF_CONF"

umask 022
cd /

# A notification on the phone's screen, from root: sent on the session bus
# of the user logged in on the seat (the first one at uid 100000 or above).
notify_user() {
  for dir in "${REEF_RUN_USER:-/run/user}"/*; do
    uid=${dir##*/}
    case "$uid" in '' | *[!0-9]*) continue ;; esac
    [ "$uid" -ge 100000 ] && [ -S "$dir/dbus/user_bus_socket" ] || continue
    user=$(getent passwd "$uid" | cut -d : -f 1)
    [ -n "$user" ] || continue
    runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$dir/dbus/user_bus_socket" \
      gdbus call --session --dest org.freedesktop.Notifications \
      --object-path /org/freedesktop/Notifications \
      --method org.freedesktop.Notifications.Notify -- \
      "Reef" 0 "icon-lock-information" "$1" "$2" "[]" \
      "{\"x-nemo-preview-summary\": <\"$1\">, \"x-nemo-preview-body\": <\"$2\">}" \
      -1 >/dev/null 2>&1 && return 0
  done
  return 1
}

log() {
  # $1 priority (syslog number), rest message. To the log file and journal.
  prio=$1
  shift
  printf '%s [%s] %s\n' "$(date -Iseconds)" "$called" "$*"
  systemd-cat -t "$called" -p "$prio" printf '%s' "$*" 2>/dev/null || true
}

if [ "${notify_mode:-0}" = 1 ]; then
  notify_user "$2" "$3"
  exit $?
fi

log 6 "started, logging to $logfile"
# shellcheck disable=SC1091
. /etc/os-release 2>/dev/null
log 7 "os-release: ${ID:-?} ${VERSION_ID:-?} ${SAILFISH_FLAVOUR:-?}"
log 7 "installed release per shipwright-reef-repo: $($REPO_TOOL release 2>&1)"
log 7 "ssu lr entry: $(ssu lr 2>/dev/null | grep -F " $REEF_ALIAS " | tr -s ' ')"

# 1. Let the RPM transaction that ran %posttrans finish (at most 10 s).
i=0
# shellcheck disable=SC2009 # busybox has no pgrep -x on older images
while [ $i -lt 10 ] && ps -eo pid | grep -qx "[[:space:]]*$ppid_wait"; do
  sleep 1
  i=$((i + 1))
done
sleep 1
# Most pkcon subcommands wait until the backend is idle, so this doubles as
# a synchronisation point (the Chum installer uses `pkcon search name`).
pkcon -p search name "$called" >/dev/null 2>&1

# 2. Is there anything for this release? Sailfish OS 5.1, for one, has no
# repository: refreshing it failed four times over ("Can't access the given
# URL"), PackageKit was restarted and the install failed anyway, with nothing
# on the screen to say why. Instead: say so, and remove this package (its
# %preun unregisters the repository; the key is not imported yet).
# Offline or unsure (5): carry on as before, the refresh retries.
release=$($REPO_TOOL release 2>/dev/null) || release="?"
check=5
for attempt in 1 2 3; do
  out=$($REPO_TOOL check 2>&1)
  check=$?
  log 6 "release check: $out"
  [ $check = 5 ] || break
  sleep $((attempt * 5))
done
# Says why on the screen, removes this package (its %preun unregisters the
# repository) and stops: nothing is installed.
give_up() {
  notify_user "Reef cannot be installed" "$1" || log 4 "could not show the notification"
  # Detached, after this script: the removal deletes this file.
  # shellcheck disable=SC2016 # expanded by the inner shell
  setsid --fork sh -c '
    sleep 2
    printf "%s [%s] %s\n" "$(date -Iseconds)" "$2" "pkcon -py remove $1"
    pkcon -py remove "$1"
    printf "%s [%s] removal exited %s\n" "$(date -Iseconds)" "$2" "$?"
  ' sh_reef_remove "$REEF_INSTALLER_PACKAGE" "$called" >>"$logfile" 2>&1 </dev/null
}
if [ $check = 4 ]; then
  log 3 "no Reef repository for Sailfish OS $release; removing $REEF_INSTALLER_PACKAGE"
  give_up "Reef has no apps for Sailfish OS $release yet. reefstore.app/install lists the releases it supports."
  exit 4
fi

# 3. Trust the Reef signing key. Without it nothing from the repository can
# be verified, so the install stops here rather than carry on unverified.
if $REPO_TOOL import-key; then
  log 6 "imported $REEF_KEY_FILE"
else
  log 3 "rpm --import $REEF_KEY_FILE failed; removing $REEF_INSTALLER_PACKAGE"
  give_up "Reef's signing key could not be added to the phone, so nothing was installed. Try installing Reef again."
  exit 6
fi

# 4. Refresh our repository only. A failure (offline, PackageKit busy with
# someone else's transaction) is retried with longer waits, up to about
# three minutes; nothing of anyone else's is stopped. Still failing, the
# install below is tried anyway (PackageKit refreshes what it needs) and
# says on the screen if it fails.
refresh="pkcon -pv repo-set-data $REEF_ALIAS refresh-now true"
retc=1
for attempt in 1 2 3 4 5; do
  log 6 "[step 1/2] $refresh (attempt $attempt)"
  # Never left hanging: a refresh that has not finished in 2 minutes is
  # this script's own pkcon, and only that one is stopped.
  $refresh &
  rpid=$!
  i=0
  while [ $i -lt 120 ] && kill -0 $rpid 2>/dev/null; do sleep 1; i=$((i + 1)); done
  kill $rpid 2>/dev/null && log 4 "refresh still running after 120 s; stopped this script's pkcon ($rpid)"
  wait $rpid
  retc=$?
  [ $retc = 0 ] && break
  [ $attempt = 5 ] && break
  wait_s=$((attempt * attempt * 4))
  log 5 "refresh failed ($retc); retrying in $wait_s s"
  sleep $wait_s
done
[ $retc = 0 ] || log 4 "refresh failed $attempt times ($retc); installing anyway"

# 5. Install the client, detached: installing it removes this script.
install="pkcon -pvy install $REEF_CLIENT_PACKAGE"
# shellcheck disable=SC2016 # expanded by the inner shell, from its arguments
setsid --fork sh -c '
  sleep 1
  i=0
  while [ $i -le 9 ] && ps -eo pid | grep -qx "[[:space:]]*$1"; do sleep 1; i=$((i + 1)); done
  printf "%s [%s] [step 2/2] %s\n" "$(date -Iseconds)" "$3" "$2"
  systemd-cat -t "$3" -p 6 printf "%s" "executing: $2" 2>/dev/null
  $2
  s=$?
  printf "%s [%s] %s exited %s\n" "$(date -Iseconds)" "$3" "$2" "$s"
  # Failed, the client did not replace this package: its script is still
  # here to say so on the screen.
  [ $s = 0 ] || "$4" --notify "Reef could not be installed" "The download did not finish. Check the connection, then install Reef again from reefstore.app/install."
' sh_reef_install "$$" "$install" "$called" "$0" >>"$logfile" 2>&1 </dev/null

log 7 "main script finished (refresh exit $retc)"
exit $retc
